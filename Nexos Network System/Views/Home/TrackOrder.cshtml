@model TrackOrderViewModel
@{
    ViewData["Title"] = "Track Order";
}

<section class="page-hero" aria-labelledby="page-title">
    <span class="page-hero__glow" aria-hidden="true"></span>
    <div class="container page-hero__inner">
        <nav class="page-hero__crumbs" aria-label="Breadcrumb">
            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <span class="page-hero__sep" aria-hidden="true">/</span>
            <span aria-current="page">@ViewData["Title"]</span>
        </nav>
        <h1 id="page-title" class="page-hero__title">Track Your Order</h1>
        <p class="page-hero__lead">Enter the 11 character order number printed on your order receipt.</p>
        <span class="page-hero__bar" aria-hidden="true"></span>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card p-4 mb-4">
                    <form asp-action="TrackOrder" method="post" class="row gy-3 align-items-end">
                        <div class="col-md-8">
                            <label asp-for="OrderNumber" class="form-label"></label>
                            <input asp-for="OrderNumber" class="form-control" placeholder="B0000000001" />
                            <span asp-validation-for="OrderNumber" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary w-100">Track Order</button>
                        </div>
                    </form>
                </div>

                @if (Model.Searched)
                {
                    if (Model.Found)
                    {
                        <div class="card p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1">Order @Model.FoundOrderNumber</h5>
                                    <p class="text-muted small mb-0">Submitted on @Model.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p>
                                </div>
                                <partial name="_Badge" model="@((object?)Model.Status)" />
                            </div>
                            <hr />
                            <dl class="row detail-list mb-0">
                                <dt class="col-sm-4">Service type</dt>
                                <dd class="col-sm-8">@Model.ConnectionType</dd>
                                <dt class="col-sm-4">Plan</dt>
                                <dd class="col-sm-8">@(Model.PlanName ?? "Not assigned yet")</dd>
                                <dt class="col-sm-4">City</dt>
                                <dd class="col-sm-8">@(Model.City ?? "Not available")</dd>
                                <dt class="col-sm-4">Feasibility check</dt>
                                <dd class="col-sm-8">@(Model.HasFeasibility ? "Completed" : "Pending")</dd>
                            </dl>
                            <div class="alert alert-info mb-0 small">
                                Statuses update as our team processes your order: Pending &rarr; Feasibility Pending &rarr; Feasible &rarr; Connection Provided.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="empty-state">
                                <div class="empty-icon">&#128269;</div>
                                <h6>No order found</h6>
                                <p class="mb-3">We could not find an order with the number <strong>@Model.OrderNumber</strong>. Please check the number on your receipt.</p>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Contact">Contact Support</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
