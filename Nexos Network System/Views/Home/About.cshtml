@{
    ViewData["Title"] = "About Us";
}

<section class="hero" style="padding: 3.5rem 0 3rem;">
    <div class="container">
        <h1 class="display-6">About NEXUS</h1>
        <p class="lead mb-0">Connecting homes and businesses with dependable dial-up, broadband and telephone services.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-6">
                <h2 class="section-title">Who we are</h2>
                <p class="text-muted">
                    NEXUS is a regional internet and telephony service provider. Our retail branches
                    in Karachi, Lahore and Islamabad register customers and place service orders, our technical
                    teams verify feasibility and install connections, and our accounts department manages billing
                    and payments.
                </p>
                <p class="text-muted">
                    Every order placed with us is tracked through a unique order number and every connection is
                    issued a unique account number, so customers always know exactly where their request stands.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="row gy-3">
                    <div class="col-6">
                        <div class="card p-3 h-100">
                            <h6 class="mb-1">3 Branches</h6>
                            <p class="text-muted small mb-0">Karachi, Lahore and Islamabad</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card p-3 h-100">
                            <h6 class="mb-1">3 Service Types</h6>
                            <p class="text-muted small mb-0">Dial-up, broadband and telephone</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card p-3 h-100">
                            <h6 class="mb-1">Dedicated Teams</h6>
                            <p class="text-muted small mb-0">Retail, technical and accounts staff</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card p-3 h-100">
                            <h6 class="mb-1">Transparent Billing</h6>
                            <p class="text-muted small mb-0">Itemised bills with service tax</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="text-center">
            <h2 class="section-title">How we work</h2>
            <p class="section-subtitle">From order to active connection in a clear, trackable process.</p>
        </div>
        <div class="row gy-4">
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <span class="badge bg-primary mb-2" style="width: fit-content;">Step 1</span>
                    <h6>Place an order</h6>
                    <p class="text-muted small mb-0">Visit a retail branch and register your request. You receive a unique order number.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <span class="badge bg-primary mb-2" style="width: fit-content;">Step 2</span>
                    <h6>Feasibility check</h6>
                    <p class="text-muted small mb-0">Our technical team verifies network availability at your address and records the result.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <span class="badge bg-primary mb-2" style="width: fit-content;">Step 3</span>
                    <h6>Installation &amp; activation</h6>
                    <p class="text-muted small mb-0">Equipment is assigned, the connection is installed and your account becomes active.</p>
                </div>
            </div>
        </div>
    </div>
</section>
