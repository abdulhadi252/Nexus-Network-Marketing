    <span class="svc-hero__grid-pattern" aria-hidden="true"></span>
    <span class="svc-hero__glow" aria-hidden="true"></span>
    <div class="container svc-hero__inner">
        <div class="svc-hero__copy">
            <p class="svc-eyebrow svc-eyebrow--light">Legal</p>
            <h1 id="page-title" class="svc-hero__title">
                Terms &amp; <span>Conditions</span>
            </h1>
