@model ConnectionStatusViewModel
@{
    ViewData["Title"] = "Connection Status";
}

<section class="page-hero" aria-labelledby="page-title">
    <span class="page-hero__glow" aria-hidden="true"></span>
    <div class="container page-hero__inner">
        <nav class="page-hero__crumbs" aria-label="Breadcrumb">
            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <span class="page-hero__sep" aria-hidden="true">/</span>
            <span aria-current="page">@ViewData["Title"]</span>
        </nav>
        <h1 id="page-title" class="page-hero__title">Check Connection Status</h1>
        <p class="page-hero__lead">Enter your 16 character account number (for example B001000000000001).</p>
        <span class="page-hero__bar" aria-hidden="true"></span>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card p-4 mb-4">
                    <form asp-action="ConnectionStatus" method="post" class="row gy-3 align-items-end">
                        <div class="col-md-8">
                            <label asp-for="AccountNumber" class="form-label"></label>
                            <input asp-for="AccountNumber" class="form-control" placeholder="B001000000000001" />
                            <span asp-validation-for="AccountNumber" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary w-100">Check Status</button>
                        </div>
                    </form>
                </div>

                @if (Model.Searched)
                {
                    if (Model.Found)
                    {
                        <div class="card p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1">Account @Model.FoundAccountNumber</h5>
                                    <p class="text-muted small mb-0">@Model.ConnectionType service in @Model.City</p>
                                </div>
                                <partial name="_Badge" model="@((object?)Model.Status)" />
                            </div>
                            <hr />
                            <dl class="row detail-list mb-0">
                                <dt class="col-sm-4">Current plan</dt>
                                <dd class="col-sm-8">@(Model.PlanName ?? "Not assigned")</dd>
                                <dt class="col-sm-4">Activated on</dt>
                                <dd class="col-sm-8">@(Model.ActivatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "Not activated yet")</dd>
                            </dl>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="empty-state">
                                <div class="empty-icon">&#128269;</div>
                                <h6>No connection found</h6>
                                <p class="mb-3">We could not find a connection with the account number <strong>@Model.AccountNumber</strong>. Please verify the number on your bill.</p>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Contact">Contact Support</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
