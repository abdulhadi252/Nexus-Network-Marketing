@using Nexos_Network_System.Models.Enums
@using Nexos_Network_System.ViewModels
@model PaymentsIndexViewModel
@{
    ViewData["Title"] = "Payments";

    string PageUrl(int page) => Url.Action("Index", "Payments", new
    {
        q = Model.Q,
        method = Model.Method,
        status = Model.Status,
        from = Model.From?.ToString("yyyy-MM-dd"),
        to = Model.To?.ToString("yyyy-MM-dd"),
        page
    })!;

    // 1 2 3 ... 8 style window
    var pages = new List<int>();
    for (var p = 1; p <= Model.TotalPages; p++)
    {
        if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 1) pages.Add(p);
    }
}

<link rel="stylesheet" href="~/css/admin-payments.css" asp-append-version="true" />
<partial name="_PaymentIcons" />

<div class="pay-page">

    @* ===== Header ===== *@
    <header class="pay-head">
        <span class="pay-head__icon"><svg class="pay-ico"><use href="#pi-card" /></svg></span>
        <div>
            <h1>Payments</h1>
            <p>Track transactions, receipts, and customer billing activity.</p>
        </div>
    </header>

    @* ===== Summary cards ===== *@
    <section class="pay-stats" aria-label="Payment summary">
        <article class="pay-stat pay-stat--blue">
            <span class="pay-stat__icon"><svg class="pay-ico"><use href="#pi-coins" /></svg></span>
            <div>
                <span class="pay-stat__label">Total collected</span>
                <strong class="pay-stat__value"><small>PKR</small> @Model.TotalCollected.ToString("N2")</strong>
                <span class="pay-stat__hint">From all successful payments</span>
            </div>
        </article>

        <article class="pay-stat pay-stat--green">
            <span class="pay-stat__icon"><svg class="pay-ico"><use href="#pi-check" /></svg></span>
            <div>
                <span class="pay-stat__label">Successful payments</span>
            <strong class="pay-stat__value">@Model.SuccessCount.ToString("N0")</strong>
            <span class="pay-stat__hint">@Model.SuccessRate.ToString("0.#")% success rate</span>
            </div>
        </article>

        <article class="pay-stat pay-stat--amber">
            <span class="pay-stat__icon"><svg class="pay-ico"><use href="#pi-clock" /></svg></span>
            <div>
                <span class="pay-stat__label">Pending</span>
                <strong class="pay-stat__value">@Model.PendingCount.ToString("N0")</strong>
                <span class="pay-stat__hint">Awaiting confirmation</span>
            </div>
        </article>

        <article class="pay-stat pay-stat--rose">
            <span class="pay-stat__icon"><svg class="pay-ico"><use href="#pi-refresh" /></svg></span>
            <div>
                <span class="pay-stat__label">Refunded</span>
                <strong class="pay-stat__value"><small>PKR</small> @Model.RefundedAmount.ToString("N0")</strong>
                <span class="pay-stat__hint">Total refunded amount</span>
            </div>
        </article>
    </section>

    @* ===== Filters ===== *@
    <form class="pay-filters" method="get" asp-controller="Payments" asp-action="Index" role="search">
        <label class="pay-field pay-field--search">
            <span class="pay-sr">Search payments</span>
            <svg class="pay-ico"><use href="#pi-search" /></svg>
            <input type="search" name="q" value="@Model.Q" placeholder="Search receipt, customer, or bill..." />
        </label>

        <label class="pay-field-group">
            <span>Payment method</span>
            <select name="method">
                <option value="">All methods</option>
                @foreach (var m in Enum.GetValues<PaymentMethod>())
                {
                    <option value="@m" selected="@(Model.Method == m)">@PaymentUi.MethodLabel(m)</option>
                }
            </select>
        </label>

        <label class="pay-field-group">
            <span>Payment status</span>
            <select name="status">
                <option value="">All status</option>
                @foreach (var s in Enum.GetValues<PaymentStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s)">@PaymentUi.StatusLabel(s)</option>
                }
            </select>
        </label>

        <div class="pay-field-group pay-field-group--dates">
            <span>Date range</span>
            <div class="pay-dates">
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" aria-label="From date" />
                <i aria-hidden="true">to</i>
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" aria-label="To date" />
            </div>
        </div>

        <div class="pay-filters__btns">
            <button type="submit" class="pay-btn pay-btn--primary">
                <svg class="pay-ico"><use href="#pi-search" /></svg> Search
            </button>
            <a class="pay-btn pay-btn--ghost" asp-controller="Payments" asp-action="Index">
                <svg class="pay-ico"><use href="#pi-reset" /></svg> Reset
            </a>
        </div>
    </form>

    @* ===== Table ===== *@
    <section class="pay-card" aria-labelledby="pay-table-title">
        <div class="pay-card__head">
            <h2 id="pay-table-title">Payment transactions <span class="pay-count">@Model.TotalCount.ToString("N0")</span></h2>
            <button type="button" class="pay-btn pay-btn--ghost pay-btn--sm" id="pay-export">
                <svg class="pay-ico"><use href="#pi-export" /></svg> Export
            </button>
        </div>

        @if (Model.Payments.Count == 0)
        {
            <div class="pay-empty">
                <svg class="pay-ico"><use href="#pi-card" /></svg>
                <h3>@(Model.HasFilters ? "No payments match these filters" : "No payments recorded yet")</h3>
                <p>@(Model.HasFilters ? "Try a different search term or clear the filters." : "Payments will show up here as soon as they are recorded.")</p>
                @if (Model.HasFilters)
                {
                    <a class="pay-btn pay-btn--ghost" asp-controller="Payments" asp-action="Index">Clear filters</a>
                }
            </div>
        }
        else
        {
            <div class="pay-table-wrap">
                <table class="pay-table" id="pay-table">
                    <thead>
                        <tr>
                            <th scope="col">Receipt</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Bill / Account</th>
                            <th scope="col">Payment method</th>
                            <th scope="col">Date</th>
                            <th scope="col" class="pay-amount">Amount (PKR)</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="pay-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Payments)
                        {
                            <partial name="_PaymentTableRow" model="payment" />
                        }
                    </tbody>
                </table>
            </div>

            <footer class="pay-pager">
                <p>Showing @Model.ShowingFrom – @Model.ShowingTo of @Model.TotalCount.ToString("N0") transactions</p>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Payments pages">
                        <ul>
                            <li>
                                @if (Model.Page > 1)
                                {
                                    <a class="pay-page-btn" href="@PageUrl(Model.Page - 1)" aria-label="Previous page"><svg class="pay-ico"><use href="#pi-prev" /></svg></a>
                                }
                                else
                                {
                                    <span class="pay-page-btn is-disabled" aria-hidden="true"><svg class="pay-ico"><use href="#pi-prev" /></svg></span>
                                }
                            </li>

                            @for (var i = 0; i < pages.Count; i++)
                            {
                                if (i > 0 && pages[i] - pages[i - 1] > 1)
                                {
                                    <li><span class="pay-page-gap">…</span></li>
                                }
                                <li>
                                    <a class="pay-page-btn @(pages[i] == Model.Page ? "is-active" : "")" href="@PageUrl(pages[i])"
                                       aria-current="@(pages[i] == Model.Page ? "page" : null)">@pages[i]</a>
                                </li>
                            }

                            <li>
                                @if (Model.Page < Model.TotalPages)
                                {
                                    <a class="pay-page-btn" href="@PageUrl(Model.Page + 1)" aria-label="Next page"><svg class="pay-ico"><use href="#pi-next" /></svg></a>
                                }
                                else
                                {
                                    <span class="pay-page-btn is-disabled" aria-hidden="true"><svg class="pay-ico"><use href="#pi-next" /></svg></span>
                                }
                            </li>
                        </ul>
                    </nav>
                }
            </footer>
        }
    </section>
</div>

<script src="~/js/admin-payments.js" asp-append-version="true"></script>
