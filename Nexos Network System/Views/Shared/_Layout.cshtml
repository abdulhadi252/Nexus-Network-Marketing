<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NEXUS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    <script>
        // Skip the branded boot loader when this tab has booted recently, so it
        // never replays on internal navigation or a quick refresh.
        try {
            if (Date.now() - Number(sessionStorage.getItem("nx-boot") || 0) < 1800000) {
                document.documentElement.classList.add("nx-booted");
            }
        } catch (e) { /* storage unavailable */ }
    </script>
</head>
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string NavActive(string action) =>
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<body>
    <partial name="_Icons" />
    <header class="public-header">
        <nav class="public-navbar navbar navbar-expand-md">
            <div class="container nav-inner">
                <a class="navbar-brand brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <partial name="_Brand" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"
                        aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="publicNav">
                    <ul class="navbar-nav nav-main">
                        <li class="nav-item"><a class="nav-link @NavActive("Index")" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @NavActive("Services")" asp-area="" asp-controller="Home" asp-action="Services">Services</a></li>
                        <li class="nav-item"><a class="nav-link @NavActive("Plans")" asp-area="" asp-controller="Home" asp-action="Plans">Plans</a></li>
                        <li class="nav-item"><a class="nav-link @NavActive("About")" asp-area="" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link @NavActive("Contact")" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                    <ul class="navbar-nav nav-cta">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var panelUrl = User.IsInRole("Admin") ? "/Admin"
                                : User.IsInRole("Retail") ? "/Retail"
                                : User.IsInRole("Technical") ? "/Technical"
                                : User.IsInRole("Accounts") ? "/Accounts"
                                : User.IsInRole("Customer") ? "/Customer"
                                : null;
                            if (panelUrl != null)
                            {
                                <li class="nav-item"><a class="nav-link" href="@panelUrl">My Panel</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="Profile">Profile</a></li>
                            <li class="nav-item">
                                <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-start">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary" asp-area="Identity" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-area="Identity" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="footer-brand brand mb-2"><partial name="_Brand" /></div>
                    <p class="footer-tagline">Network &amp; Internet Services</p>
                    <p class="mb-0">
                        Connecting homes, businesses and communities with reliable internet
                        and voice services.
                    </p>
                    @* Social profile URLs are intentionally left blank until the official
                       NEXUS accounts exist; fill in the href values to activate them. *@
                    <div class="footer-social">
                        <a href="#" aria-label="NEXUS on Facebook"><svg aria-hidden="true"><use href="#i-facebook" /></svg></a>
                        <a href="#" aria-label="NEXUS on X"><svg aria-hidden="true"><use href="#i-x" /></svg></a>
                        <a href="#" aria-label="NEXUS on LinkedIn"><svg aria-hidden="true"><use href="#i-linkedin" /></svg></a>
                        <a href="#" aria-label="NEXUS on YouTube"><svg aria-hidden="true"><use href="#i-youtube" /></svg></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2 footer-links">
                    <h6>Useful Links</h6>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-area="" asp-controller="Home" asp-action="Services">Services</a>
                    <a asp-area="" asp-controller="Home" asp-action="Plans">Plans</a>
                    <a asp-area="" asp-controller="Home" asp-action="About">About Us</a>
                    <a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                </div>
                <div class="col-6 col-lg-3 footer-links">
                    <h6>Customer Services</h6>
                    <a asp-area="" asp-controller="Home" asp-action="TrackOrder">Track Order</a>
                    <a asp-area="" asp-controller="Home" asp-action="ConnectionStatus">Connection Status</a>
                    <a asp-area="Identity" asp-controller="Account" asp-action="Login">Billing &amp; Payments</a>
                    <a asp-area="" asp-controller="Home" asp-action="Contact">Technical Help</a>
                    <a asp-area="" asp-controller="Home" asp-action="Contact">FAQ</a>
                    <a asp-area="Identity" asp-controller="Account" asp-action="Login">Customer / Employee Login</a>
                </div>
                <div class="col-lg-3 footer-links">
                    <h6>Contact</h6>
                    <a href="mailto:support@nexos.local">support&#64;nexos.local</a>
                    <a href="tel:+922111122333">+92 21 111 122 333</a>
                    <span class="footer-address">Karachi &middot; Lahore &middot; Islamabad</span>
                </div>
            </div>
            <div class="footer-bottom d-flex flex-wrap justify-content-between align-items-center">
                <span>&copy; 2026 NEXUS. All rights reserved.</span>
                <span class="footer-bottom__meta">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a asp-area="" asp-controller="Home" asp-action="Terms">Terms &amp; Conditions</a>
                    <span class="footer-bottom__tag">Connect. Simplify. Scale.</span>
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
