@model PanelUserViewModel

<div class="dropdown">
    <button class="panel-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="panel-chip__avatar">@Model.Initial</span>
        <span class="panel-chip__meta">
            <span class="panel-chip__name">@Model.DisplayName</span>
            <span class="panel-chip__role">@Model.RoleLabel</span>
        </span>
        <svg class="svg-icon panel-chip__caret"><use href="#i-chevron-down" /></svg>
    </button>

    <ul class="dropdown-menu dropdown-menu-end">
        <li>
            <a class="dropdown-item" asp-area="Identity" asp-controller="Account" asp-action="Profile">My Profile</a>
        </li>
        <li>
            <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Public website</a>
        </li>
        <li><hr class="dropdown-divider" /></li>
        <li>
            <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="dropdown-item">Logout</button>
            </form>
        </li>
    </ul>
</div>
