@model ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Change Password";
}

<h1 class="h4 mb-1">Change Password</h1>
<p class="text-muted">Passwords are verified and hashed by ASP.NET Core Identity. Passwords are never stored or displayed in plain text.</p>

<div class="card" style="max-width: 560px;">
    <div class="card-body">
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                <span class="text-muted small">Minimum 8 characters, with at least one uppercase letter, one lowercase letter and one digit.</span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Change Password</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
