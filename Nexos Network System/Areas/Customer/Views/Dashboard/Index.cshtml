@model CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">My Account</h1>
        <p class="text-muted mb-0">Your connection, billing and payment overview.</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Feedback" asp-action="Create">+ Give Feedback</a>
</div>

@if (Model.Connections.Count == 0)
{
    <div class="card mb-3">
        <div class="empty-state">
            <div class="empty-icon"><svg class="svg-icon"><use href="#i-connections" /></svg></div>
            <h6>No connections yet</h6>
            <p class="mb-2">Place a service order online and follow its progress from your account.</p>
            <a class="btn btn-primary" asp-controller="Orders" asp-action="Create">Place an order</a>
        </div>
    </div>
}
else
{
    var primaryConnection = Model.Connections[0];
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card card h-100">
                <div class="stat-label">Account Number</div>
                <div class="stat-value" style="font-size: 1.05rem;">@primaryConnection.AccountNumber</div>
                <div class="text-muted small">@primaryConnection.ConnectionType &middot; @primaryConnection.City?.Name</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card card h-100">
                <div class="stat-label">Connection Status</div>
                <div class="mt-1 mb-1"><partial name="_Badge" model="@((object?)primaryConnection.Status)" /></div>
                <div class="text-muted small">Current plan: @primaryConnection.Plan?.Name</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card card h-100">
                <div class="stat-label">Outstanding Amount</div>
                <div class="stat-value @(Model.OutstandingAmount > 0 ? "text-danger" : "text-success")">
                    PKR @Model.OutstandingAmount.ToString("N2")
                </div>
                @if (Model.CurrentBill is not null)
                {
                    <div class="text-muted small">Latest bill: @Model.CurrentBill.BillNumber</div>
                }
            </div>
        </div>
    </div>
}

@if (Model.CurrentBill is not null)
{
    <div class="card p-4 mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h6 class="mb-1">Latest Bill</h6>
                <p class="text-muted small mb-0">
                    @Model.CurrentBill.BillNumber &middot; period @Model.CurrentBill.BillingPeriodStart.ToString("dd MMM") - @Model.CurrentBill.BillingPeriodEnd.ToString("dd MMM yyyy") &middot; due @Model.CurrentBill.DueDate.ToString("dd MMM yyyy")
                </p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <partial name="_Badge" model="@((object?)Model.CurrentBill.Status)" />
                <span class="fw-bold text-price">PKR @Model.CurrentBill.DueAmount.ToString("N2") due</span>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Bills" asp-action="Details" asp-route-id="@Model.CurrentBill.Id">View bill</a>
            </div>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Orders</span>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Orders" asp-action="Index">View all</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentOrders.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No orders yet.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Order</th><th>Plan</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-semibold">@order.OrderNumber</td>
                                        <td>@(order.Plan?.Name ?? "-")</td>
                                        <td><partial name="_Badge" model="@((object?)order.Status)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Payments</span>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Payments" asp-action="Index">View all</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentPayments.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No payments recorded yet.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Receipt</th><th>Date</th><th>Amount</th></tr></thead>
                            <tbody>
                                @foreach (var payment in Model.RecentPayments)
                                {
                                    <tr>
                                        <td class="fw-semibold">@payment.ReceiptNumber</td>
                                        <td>@payment.PaidAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                        <td class="text-price">PKR @payment.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
