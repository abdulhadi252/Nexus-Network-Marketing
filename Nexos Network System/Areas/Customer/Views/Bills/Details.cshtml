@model Bill
@{
    ViewData["Title"] = "Bill Details";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.BillNumber</h1>
        <p class="text-muted mb-0">
            @Model.Connection.AccountNumber &middot; @Model.Connection.Plan?.Name &middot;
            <partial name="_Badge" model="@((object?)Model.Status)" />
        </p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to bills</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">Charges</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Description</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Description</td>
                                    <td class="text-end text-price">PKR @item.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Total payable</th>
                                <th class="text-end text-price">PKR @((Model.TotalAmount + Model.PreviousBalance - Model.PreviousPaidAmount).ToString("N2"))</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-4 mb-3">
            <h6 class="mb-3">Summary</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-7">Billing period</dt>
                <dd class="col-5">@Model.BillingPeriodStart.ToString("dd MMM") - @Model.BillingPeriodEnd.ToString("dd MMM yyyy")</dd>
                <dt class="col-7">Due date</dt>
                <dd class="col-5">@Model.DueDate.ToString("dd MMM yyyy")</dd>
                <dt class="col-7">Monthly rental</dt>
                <dd class="col-5 text-price">PKR @Model.MonthlyRental.ToString("N2")</dd>
                <dt class="col-7">Service tax (12.24%)</dt>
                <dd class="col-5 text-price">PKR @Model.ServiceTaxAmount.ToString("N2")</dd>
                <dt class="col-7">Total</dt>
                <dd class="col-5 text-price">PKR @Model.TotalAmount.ToString("N2")</dd>
                <dt class="col-7">Paid</dt>
                <dd class="col-5 text-price">PKR @Model.PaidAmount.ToString("N2")</dd>
                <dt class="col-7 fw-bold">Due</dt>
                <dd class="col-5 text-price fw-bold">PKR @Model.DueAmount.ToString("N2")</dd>
            </dl>
        </div>
        <div class="card p-4">
            <h6 class="mb-3">Payments</h6>
            @if (Model.Payments.Count == 0)
            {
                <p class="text-muted mb-0">No payments recorded for this bill yet. Payments can be made at any NEXUS branch.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaidAt))
                    {
                        <li class="d-flex justify-content-between mb-2">
                            <span>@payment.ReceiptNumber <span class="text-muted small">(@payment.PaidAt.ToLocalTime().ToString("dd MMM yyyy"), @payment.Method)</span></span>
                            <span class="text-price">PKR @payment.Amount.ToString("N2")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
