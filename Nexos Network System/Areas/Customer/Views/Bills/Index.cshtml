@model IReadOnlyList<Bill>
@{
    ViewData["Title"] = "My Bills";
    var outstanding = Model.SumLatestOutstanding();
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">My Bills</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">My Bills</h1>
        <p class="page-subtitle">Every bill generated for your connections, newest first.</p>
        <p class="page-subtitle__meta">Total outstanding: <strong class="@(outstanding > 0 ? "text-danger" : "text-success")">PKR @outstanding.ToString("N2")</strong></p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-bills" /></svg></span>
                <p class="mb-0">You do not have any bills yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Bill</th><th>Account</th><th>Period</th><th>Due date</th><th>Total</th><th>Paid</th><th>Due</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@bill.BillNumber</td>
                                <td>@bill.Connection.AccountNumber</td>
                                <td>@bill.BillingPeriodStart.ToString("MMM yyyy")</td>
                                <td>@bill.DueDate.ToString("dd MMM yyyy")</td>
                                <td class="text-price">PKR @bill.TotalAmount.ToString("N2")</td>
                                <td class="text-price">PKR @bill.PaidAmount.ToString("N2")</td>
                                <td class="text-price">PKR @bill.DueAmount.ToString("N2")</td>
                                <td><partial name="_StatusPill" model="@((object?)bill.Status)" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@bill.Id">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
