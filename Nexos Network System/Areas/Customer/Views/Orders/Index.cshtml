@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "My Orders";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">My Orders</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">My Orders</h1>
        <p class="page-subtitle">Track the status of every order you have placed.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-primary" asp-action="Create">+ Place Order</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-orders" /></svg></span>
                <p class="mb-2">You have not placed any orders yet.</p>
                <a class="btn btn-primary" asp-action="Create">Place an order</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Order</th><th>Type</th><th>Plan</th><th>Submitted</th><th>Feasibility</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@order.OrderNumber</td>
                                <td>@order.ConnectionType</td>
                                <td>@(order.Plan?.Name ?? "-")</td>
                                <td>@order.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (order.FeasibilityReport is null)
                                    {
                                        <span class="text-muted">Pending</span>
                                    }
                                    else
                                    {
                                        <partial name="_StatusPill" model="@((object?)order.FeasibilityReport.Status)" />
                                    }
                                </td>
                                <td><partial name="_StatusPill" model="@((object?)order.Status)" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@order.Id">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
