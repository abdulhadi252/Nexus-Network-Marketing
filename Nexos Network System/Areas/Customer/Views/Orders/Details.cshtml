@model Order
@{
    ViewData["Title"] = "Order Details";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">My Orders</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Order @Model.OrderNumber</h1>
        <p class="page-subtitle">
            @Model.ConnectionType &middot; submitted @Model.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy") &middot;
            <partial name="_StatusPill" model="@((object?)Model.Status)" />
        </p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Back to orders</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card p-4 mb-3">
            <h6 class="mb-3">Order Summary</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-5">Plan</dt>
                <dd class="col-7">@(Model.Plan?.Name ?? "-")</dd>
                <dt class="col-5">Recurring charge</dt>
                <dd class="col-7 text-price">@(Model.Plan is null ? "-" : $"PKR {Model.Plan.RecurringCharge:N2}")</dd>
                <dt class="col-5">Security deposit</dt>
                <dd class="col-7 text-price">@(Model.Plan is null ? "-" : $"PKR {Model.Plan.SecurityDeposit:N2}")</dd>
                <dt class="col-5">Installation charge</dt>
                <dd class="col-7 text-price">@(Model.Plan is null ? "-" : $"PKR {Model.Plan.InstallationCharge:N2}")</dd>
                <dt class="col-5">Last updated</dt>
                <dd class="col-7">@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                <dt class="col-5">Remarks</dt>
                <dd class="col-7">@(Model.Remarks ?? "-")</dd>
            </dl>
        </div>

        <div class="card p-4">
            <h6 class="mb-3">Requested Products</h6>
            @if (Model.Items.Count == 0)
            {
                <p class="text-muted mb-0">No products were requested with this order.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Product</th><th>Qty</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr><td>@item.Product.Name</td><td>@item.Quantity</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card p-4 mb-3">
            <h6 class="mb-3">Feasibility</h6>
            @if (Model.FeasibilityReport is null)
            {
                <p class="text-muted mb-0">Our technical team has not checked your site yet.</p>
            }
            else
            {
                <dl class="row detail-list mb-0">
                    <dt class="col-5">Result</dt>
                    <dd class="col-7"><partial name="_StatusPill" model="@((object?)Model.FeasibilityReport.Status)" /></dd>
                    <dt class="col-5">Checked at</dt>
                    <dd class="col-7">@(Model.FeasibilityReport.CheckedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-5">Remarks</dt>
                    <dd class="col-7">@(Model.FeasibilityReport.Remarks ?? "-")</dd>
                </dl>
            }
        </div>

        <div class="card p-4 mb-3">
            <h6 class="mb-3">Connection</h6>
            @if (Model.Connection is null)
            {
                <p class="text-muted mb-0">A connection account number will be issued once your order is approved.</p>
            }
            else
            {
                <dl class="row detail-list mb-0">
                    <dt class="col-5">Account number</dt>
                    <dd class="col-7 fw-semibold">@Model.Connection.AccountNumber</dd>
                    <dt class="col-5">Status</dt>
                    <dd class="col-7"><partial name="_StatusPill" model="@((object?)Model.Connection.Status)" /></dd>
                    <dt class="col-5">Activated</dt>
                    <dd class="col-7">@(Model.Connection.ActivatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "-")</dd>
                </dl>
                <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Connection" asp-action="Index">My Connections</a>
            }
        </div>

        <div class="card p-4">
            <h6 class="mb-3">Assigned Equipment</h6>
            @if (Model.Connection is null || Model.Connection.EquipmentItems.Count == 0)
            {
                <p class="text-muted mb-0">Equipment assigned by technical will appear here. Open any assigned item to view it, request its cancellation or return it.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Product</th><th>Asset tag</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var equipment in Model.Connection.EquipmentItems.OrderBy(e => e.AssetTag))
                            {
                                <tr>
                                    <td>@(equipment.Product?.Name ?? "-")</td>
                                    <td>@equipment.AssetTag</td>
                                    <td><partial name="_StatusPill" model="@((object?)equipment.Status)" /></td>
                                    <td class="table-actions">
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Equipment" asp-action="Details" asp-route-id="@equipment.Id">View Equipment</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
