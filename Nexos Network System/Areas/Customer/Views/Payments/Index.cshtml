@model IReadOnlyList<Payment>
@{
    ViewData["Title"] = "Payment History";
    var totalPaid = Model.Sum(p => p.Amount);
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Payment History</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Payment History</h1>
        <p class="page-subtitle">Every payment recorded against your account, newest first.</p>
        <p class="page-subtitle__meta">Total paid to date: <strong>PKR @totalPaid.ToString("N2")</strong></p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-wallet" /></svg></span>
                <p class="mb-0">No payments recorded yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Receipt</th><th>Bill</th><th>Account</th><th>Date</th><th>Method</th><th>Reference</th><th>Amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@payment.ReceiptNumber</td>
                                <td>@payment.Bill.BillNumber</td>
                                <td>@payment.Connection.AccountNumber</td>
                                <td>@payment.PaidAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@payment.Method</td>
                                <td>@(payment.PaymentReference ?? "-")</td>
                                <td class="text-price">PKR @payment.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
