@model FeedbackViewModel
@{
    ViewData["Title"] = "Submit Feedback";
}

<h1 class="h4 mb-1">Submit Feedback</h1>
<p class="text-muted">Rate your experience and tell us what we can improve.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="col-md-6">
                <label asp-for="ConnectionId" class="form-label"></label>
                <select asp-for="ConnectionId" class="form-select" asp-items="ViewBag.Connections">
                    <option value="">-- General feedback (no specific connection) --</option>
                </select>
                <span asp-validation-for="ConnectionId" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Rating" class="form-label"></label>
                <select asp-for="Rating" class="form-select">
                    <option value="">No rating</option>
                    <option value="5">&#9733;&#9733;&#9733;&#9733;&#9733; Excellent</option>
                    <option value="4">&#9733;&#9733;&#9733;&#9733; Good</option>
                    <option value="3">&#9733;&#9733;&#9733; Average</option>
                    <option value="2">&#9733;&#9733; Poor</option>
                    <option value="1">&#9733; Very poor</option>
                </select>
                <span asp-validation-for="Rating" class="field-validation-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Message" class="form-label"></label>
                <textarea asp-for="Message" class="form-control" rows="5" placeholder="Share your experience with our service, staff or billing..."></textarea>
                <span asp-validation-for="Message" class="field-validation-error"></span>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Submit Feedback</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
