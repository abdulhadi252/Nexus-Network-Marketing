@model IReadOnlyList<EquipmentRequest>
@{
    ViewData["Title"] = "Equipment Requests";

    var status = ViewData["status"]?.ToString();
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Technical" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Equipment Requests</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Equipment Requests</h1>
        <p class="page-subtitle">Cancellation and return requests raised by customers from their panel.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-outline-secondary" asp-controller="Equipment" asp-action="Index">Equipment list</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted small me-2">@pendingCount pending review</span>
        <a class="btn btn-sm @(status == nameof(EquipmentRequestStatus.Pending) ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Requests" asp-route-status="@EquipmentRequestStatus.Pending">Pending</a>
        <a class="btn btn-sm @(status == nameof(EquipmentRequestStatus.Approved) ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Requests" asp-route-status="@EquipmentRequestStatus.Approved">Approved</a>
        <a class="btn btn-sm @(status == nameof(EquipmentRequestStatus.Rejected) ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Requests" asp-route-status="@EquipmentRequestStatus.Rejected">Rejected</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-equipment" /></svg></span>
                <p class="mb-0">No equipment requests in this view.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Equipment</th>
                            <th>Customer</th>
                            <th>Connection</th>
                            <th>Type</th>
                            <th>Reason</th>
                            <th>Sent</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@request.Equipment?.AssetTag</div>
                                    <div class="text-muted small">@(request.Equipment?.Product?.Name ?? "-")</div>
                                </td>
                                <td>@request.Customer.FirstName @request.Customer.LastName</td>
                                <td>
                                    @if (request.Equipment?.Connection is null)
                                    {
                                        <span class="text-muted">Not assigned</span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Connections" asp-action="Details" asp-route-id="@request.Equipment.Connection.Id">
                                            @request.Equipment.Connection.AccountNumber
                                        </a>
                                    }
                                </td>
                                <td>@request.RequestType</td>
                                <td class="text-muted small">@(request.Reason ?? "-")</td>
                                <td>@request.RequestedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td><partial name="_StatusPill" model="@((object?)request.Status)" /></td>
                                <td class="table-actions">
                                    @if (request.Status == EquipmentRequestStatus.Pending)
                                    {
                                        <form asp-action="ReviewRequest" asp-route-id="@request.Id" method="post" class="d-flex flex-wrap gap-1">
                                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="Note (optional)" />
                                            <button type="submit" name="decision" value="Approved" class="btn btn-sm btn-outline-success">Approve</button>
                                            <button type="submit" name="decision" value="Rejected" class="btn btn-sm btn-outline-danger">Reject</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            @(request.ReviewedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "-")
                                            @if (request.ReviewedByEmployee is not null)
                                            {
                                                <span>&middot; @request.ReviewedByEmployee.FirstName @request.ReviewedByEmployee.LastName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(request.ReviewNotes))
                                            {
                                                <div>@request.ReviewNotes</div>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
