@model FeasibilityFormViewModel
@{
    ViewData["Title"] = "New Feasibility Check";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Technical" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">New Feasibility Check</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">New Feasibility Check</h1>
        <p class="page-subtitle">Record the result of a site check. The order status updates automatically.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="col-md-6">
                <label asp-for="OrderId" class="form-label"></label>
                <select asp-for="OrderId" class="form-select" asp-items="ViewBag.OrderOptions">
                    <option value="">-- Select pending order --</option>
                </select>
                <span asp-validation-for="OrderId" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<FeasibilityStatus>()"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="ServerAvailable" class="form-label">Server / Network Available</label>
                <select asp-for="ServerAvailable" class="form-select">
                    <option value="">Unknown</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="DistanceMeters" class="form-label"></label>
                <input asp-for="DistanceMeters" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="DistanceMeters" class="field-validation-error"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Technical notes, required equipment, cabling plan..."></textarea>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Record Feasibility</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
