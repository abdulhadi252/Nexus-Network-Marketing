@model PagedResult<Connection>
@{
    ViewData["Title"] = "Connections";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Technical" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Connections</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Connections</h1>
        <p class="page-subtitle">Install, activate and maintain customer connections.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-primary" asp-action="Create">+ Create Connection</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Account number or customer..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var connectionStatus in Enum.GetValues<ConnectionStatus>())
                    {
                        <option value="@connectionStatus" selected="@(ViewData["status"]?.ToString() == connectionStatus.ToString())">@connectionStatus</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No connections found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Account Number</th><th>Customer</th><th>Plan</th><th>Equipment</th><th>Activated</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var connection in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@connection.AccountNumber</td>
                                <td>@connection.Customer.FirstName @connection.Customer.LastName</td>
                                <td>@connection.Plan?.Name</td>
                                <td>@connection.EquipmentItems.Count</td>
                                <td>@(connection.ActivatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "-")</td>
                                <td><partial name="_StatusPill" model="@((object?)connection.Status)" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@connection.Id">Open</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
