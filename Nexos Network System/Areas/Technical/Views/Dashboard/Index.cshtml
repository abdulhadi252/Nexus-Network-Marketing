@model DashboardStatsViewModel
@{
    ViewData["Title"] = "Technical Dashboard";

    var feasibilityQueue = Model.PendingFeasibilityList;
    var installationQueue = Model.PendingConnectionsList;
}

<div class="dash-head">
    <div>
        <h1>Technical Dashboard</h1>
        <p>Welcome back, @Model.GreetingName! Feasibility checks, installations and equipment in the field.</p>
    </div>
    <div class="dash-period" title="Reporting period">
        <svg class="svg-icon"><use href="#i-calendar" /></svg>
        <span>@Model.PeriodLabel</span>
    </div>
</div>

@* ---------------------------------------------------------------- KPI cards *@
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--orange"><svg class="svg-icon"><use href="#i-clock" /></svg></span>
                <span class="kpi-card__label">Orders Awaiting Action</span>
            </div>
            <div class="kpi-card__value">@Model.PendingOrders.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--blue"><svg class="svg-icon"><use href="#i-feasibility" /></svg></span>
                <span class="kpi-card__label">Pending Feasibility</span>
            </div>
            <div class="kpi-card__value">@Model.PendingFeasibility.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--green"><svg class="svg-icon"><use href="#i-check-circle" /></svg></span>
                <span class="kpi-card__label">Approved Feasibility</span>
            </div>
            <div class="kpi-card__value">@Model.ApprovedFeasibility.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--purple"><svg class="svg-icon"><use href="#i-x-circle" /></svg></span>
                <span class="kpi-card__label">Not Feasible Orders</span>
            </div>
            <div class="kpi-card__value">@Model.NotFeasibleCount.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--orange"><svg class="svg-icon"><use href="#i-connections" /></svg></span>
                <span class="kpi-card__label">Pending Connections</span>
            </div>
            <div class="kpi-card__value">@Model.PendingConnections.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--green"><svg class="svg-icon"><use href="#i-broadband" /></svg></span>
                <span class="kpi-card__label">Active Connections</span>
            </div>
            <div class="kpi-card__value">@Model.ActiveConnections.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--navy"><svg class="svg-icon"><use href="#i-products" /></svg></span>
                <span class="kpi-card__label">Equipment Units</span>
            </div>
            <div class="kpi-card__value">@Model.TotalEquipment.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--cyan"><svg class="svg-icon"><use href="#i-stock" /></svg></span>
                <span class="kpi-card__label">Available Equipment</span>
            </div>
            <div class="kpi-card__value">@Model.AvailableEquipment.ToString("N0")</div>
        </article>
    </div>
</div>

@* ---------------------------------------------------------------- Work queues *@
<div class="row g-3">
    <div class="col-xl-6">
        <section class="dash-card h-100">
            <header class="dash-card__head">
                <span class="dash-card__icon"><svg class="svg-icon"><use href="#i-feasibility" /></svg></span>
                <div class="dash-card__heading">
                    <h2 class="dash-card__title">Orders Needing Feasibility</h2>
                    <p class="dash-card__sub">Site checks still to be recorded</p>
                </div>
                <a class="btn btn-sm btn-outline-primary order-card__cta ms-auto"
                   asp-controller="Feasibility" asp-action="Index">
                    All Reports
                </a>
            </header>
            <div class="dash-card__body dash-card__body--flush">
                @if (feasibilityQueue.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-check-circle" /></svg></span>
                        <p class="empty-title">Nothing waiting</p>
                        <p class="mb-0">No orders are waiting for a feasibility check.</p>
                    </div>
                }
                else
                {
                    <ul class="order-list">
                        @foreach (var report in feasibilityQueue)
                        {
                            <partial name="_OrderRow" model="report.Order" />
                        }
                    </ul>
                }
            </div>
        </section>
    </div>

    <div class="col-xl-6">
        <section class="dash-card h-100">
            <header class="dash-card__head">
                <span class="dash-card__icon"><svg class="svg-icon"><use href="#i-connections" /></svg></span>
                <div class="dash-card__heading">
                    <h2 class="dash-card__title">Pending Connections</h2>
                    <p class="dash-card__sub">Awaiting installation</p>
                </div>
                <a class="btn btn-sm btn-outline-primary order-card__cta ms-auto"
                   asp-controller="Connections" asp-action="Index" asp-route-status="Pending">
                    All Connections
                </a>
            </header>
            <div class="dash-card__body dash-card__body--flush">
                @if (installationQueue.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-check-circle" /></svg></span>
                        <p class="empty-title">Nothing pending</p>
                        <p class="mb-0">No connections are pending installation.</p>
                    </div>
                }
                else
                {
                    <ul class="order-list">
                        @foreach (var connection in installationQueue)
                        {
                            <partial name="_ConnectionRow" model="connection" />
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
</div>
