@model PagedResult<Order>
@{
    ViewData["Title"] = "Orders";
}

<h1 class="h4 mb-1">Orders</h1>
<p class="text-muted">All orders with their feasibility and connection status.</p>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Order number or customer..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No orders found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Order</th><th>Customer</th><th>Type</th><th>Plan</th><th>Feasibility</th><th>Connection</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@order.OrderNumber</td>
                                <td>@order.Customer.FirstName @order.Customer.LastName</td>
                                <td>@order.ConnectionType</td>
                                <td>@(order.Plan?.Name ?? "-")</td>
                                <td>
                                    @if (order.FeasibilityReport is null)
                                    {
                                        <span class="badge bg-secondary">Not checked</span>
                                    }
                                    else
                                    {
                                        <partial name="_Badge" model="@((object?)order.FeasibilityReport.Status)" />
                                    }
                                </td>
                                <td>@(order.Connection?.AccountNumber ?? "-")</td>
                                <td><partial name="_Badge" model="@((object?)order.Status)" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@order.Id">View</a>
                                    @if (order.FeasibilityReport is null)
                                    {
                                        <a class="btn btn-outline-primary" asp-controller="Feasibility" asp-action="Create" asp-route-orderId="@order.Id">Check</a>
                                    }
                                    else if (order.Connection is null && order.Status == OrderStatus.Feasible)
                                    {
                                        <a class="btn btn-outline-primary" asp-controller="Connections" asp-action="Create" asp-route-orderId="@order.Id">Connect</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
