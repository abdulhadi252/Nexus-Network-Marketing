@model Payment
@{
    ViewData["Title"] = "Payment Details";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Accounts" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Payments</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Receipt @Model.ReceiptNumber</h1>
        <p class="page-subtitle"><partial name="_StatusPill" model="@((object?)Model.Status)" /></p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-outline-primary" asp-controller="Bills" asp-action="Details" asp-route-id="@Model.BillId">Open bill</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to paymeacha bhai accunts kay anel main nts</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card p-4">
            <h6 class="mb-3">Payment</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-6">Amount</dt>
                <dd class="col-6 text-price">PKR @Model.Amount.ToString("N2")</dd>
                <dt class="col-6">Paid at</dt>
                <dd class="col-6">@Model.PaidAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                <dt class="col-6">Method</dt>
                <dd class="col-6">@(Model.Method == PaymentMethod.BankTransfer ? "Bank Transfer" : Model.Method == PaymentMethod.MobileWallet ? "Mobile Wallet" : Model.Method.ToString())</dd>
                <dt class="col-6">Reference</dt>
                <dd class="col-6">@(Model.PaymentReference ?? "-")</dd>
                <dt class="col-6">Recorded by</dt>
                <dd class="col-6">@(Model.RecordedByEmployee is null ? "-" : $"{Model.RecordedByEmployee.FirstName} {Model.RecordedByEmployee.LastName}")</dd>
                <dt class="col-6">Notes</dt>
                <dd class="col-6">@(Model.Notes ?? "-")</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-4">
            <h6 class="mb-3">Bill After Payment</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-5">Bill number</dt>
                <dd class="col-7">@Model.Bill.BillNumber</dd>
                <dt class="col-5">Customer</dt>
                <dd class="col-7">@Model.Customer.FirstName @Model.Customer.LastName</dd>
                <dt class="col-5">Account</dt>
                <dd class="col-7">@Model.Connection.AccountNumber</dd>
                <dt class="col-5">Plan</dt>
                <dd class="col-7">@Model.Connection.Plan?.Name</dd>
                <dt class="col-5">Bill total</dt>
                <dd class="col-7 text-price">PKR @Model.Bill.TotalAmount.ToString("N2")</dd>
                <dt class="col-5">Paid</dt>
                <dd class="col-7 text-price">PKR @Model.Bill.PaidAmount.ToString("N2")</dd>
                <dt class="col-5">Due</dt>
                <dd class="col-7 text-price">PKR @Model.Bill.DueAmount.ToString("N2")</dd>
                <dt class="col-5">Status</dt>
                <dd class="col-7"><partial name="_StatusPill" model="@((object?)Model.Bill.Status)" /></dd>
            </dl>
        </div>
    </div>
</div>

@if (Model.Status == PaymentStatus.PendingVerification)
{
    <div class="card p-4 mt-3">
        <h6 class="mb-2">Confirm this online payment</h6>
        <p class="text-muted small mb-3">
            This payment was submitted from the customer panel and has not been applied to the bill yet.
            Check that PKR @Model.Amount.ToString("N2") was received against reference @(Model.PaymentReference ?? "-"), then confirm it.
        </p>
        <div class="row g-3">
            <div class="col-md-6">
                <form asp-action="Verify" asp-route-id="@Model.Id" method="post" class="row g-2">
                    <div class="col-12">
                        <input name="notes" class="form-control" placeholder="Verification note (optional)" maxlength="1000" />
                    </div>
                    <div class="col-12 d-grid">
                        <button type="submit" class="btn btn-primary">Confirm payment</button>
                    </div>
                </form>
            </div>
            <div class="col-md-6">
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="row g-2">
                    <div class="col-12">
                        <input name="reason" class="form-control" placeholder="Why is this payment rejected?" maxlength="1000" required />
                    </div>
                    <div class="col-12 d-grid">
                        <button type="submit" class="btn btn-outline-danger">Reject payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
