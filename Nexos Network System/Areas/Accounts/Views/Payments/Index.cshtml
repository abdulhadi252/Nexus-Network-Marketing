@model PagedResult<Payment>
@{
    ViewData["Title"] = "Payments";
    var pageTotal = Model.Items.Where(p => p.Status == PaymentStatus.Recorded).Sum(p => p.Amount);
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var pendingAmount = (decimal)(ViewBag.PendingAmount ?? 0m);
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Accounts" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Payments</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Payments</h1>
        <p class="page-subtitle">Page total: PKR @pageTotal.ToString("N2")</p>
    </div>
    <div class="page-head__actions">
        @if (pendingCount > 0)
        {
            <a class="btn btn-warning" asp-action="Index" asp-route-status="@PaymentStatus.PendingVerification">
                Review @pendingCount online payment@(pendingCount == 1 ? "" : "s") (PKR @pendingAmount.ToString("N2"))
            </a>
        }
        <a class="btn btn-primary" asp-action="Create">+ Record Payment</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Receipt, customer or account" />
            </div>
            <div class="col-md-3">
                <select name="method" class="form-select">
                    <option value="">All methods</option>
                    @foreach (var method in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@method" selected="@(ViewData["method"]?.ToString() == method.ToString())">@method</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<PaymentStatus>())
                    {
                        <option value="@status" selected="@(ViewData["status"]?.ToString() == status.ToString())">@status</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No payments found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Receipt</th><th>Customer</th><th>Account</th><th>Bill</th><th>Date</th><th>Method</th><th>Amount</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@payment.ReceiptNumber</td>
                                <td>@payment.Customer.FirstName @payment.Customer.LastName</td>
                                <td>@payment.Connection.AccountNumber</td>
                                <td>@payment.Bill.BillNumber</td>
                                <td>@payment.PaidAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@payment.Method</td>
                                <td class="text-price">PKR @payment.Amount.ToString("N2")</td>
                                <td><partial name="_StatusPill" model="@((object?)payment.Status)" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@payment.Id">View</a>
                                    @if (payment.Status == PaymentStatus.PendingVerification)
                                    {
                                        <form asp-action="Verify" asp-route-id="@payment.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-primary">Confirm</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
