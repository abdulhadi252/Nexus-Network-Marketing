@model BillGenerateViewModel
@{
    ViewData["Title"] = "Generate Bill";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Accounts" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Generate Bill</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Generate Bill</h1>
        <p class="page-subtitle">Bill calculation is centralised: plan recurring charge + equipment/replacement charges - discounts,
            plus 12.24% service tax and any previous outstanding balance. The security deposit is recorded for reference only.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Generate" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="col-md-6">
                <label asp-for="ConnectionId" class="form-label"></label>
                <select asp-for="ConnectionId" class="form-select" asp-items="ViewBag.Connections">
                    <option value="">-- Select active connection --</option>
                </select>
                <span asp-validation-for="ConnectionId" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="BillingPeriodStart" class="form-label"></label>
                <input asp-for="BillingPeriodStart" type="date" class="form-control" />
                <span asp-validation-for="BillingPeriodStart" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="BillingPeriodEnd" class="form-label"></label>
                <input asp-for="BillingPeriodEnd" type="date" class="form-control" />
                <span asp-validation-for="BillingPeriodEnd" class="field-validation-error"></span>
            </div>

            <div class="col-12">
                <p class="text-muted small mb-0">
                    These amounts are filled from the selected connection's plan, the equipment assigned to it and its
                    previous bill. Accounts only needs to enter the discount (and any extra replacement charge).
                </p>
            </div>
            <div class="col-12" id="connectionCardWrapper" hidden>
                <div id="connectionCard"></div>
            </div>

            <div class="col-md-4">
                <label for="MonthlyRental" class="form-label">Monthly rental (from plan)</label>
                <input id="MonthlyRental" class="form-control" readonly aria-readonly="true" />
            </div>
            <div class="col-md-4">
                <label for="SecurityDeposit" class="form-label">Security deposit (from plan)</label>
                <input id="SecurityDeposit" class="form-control" readonly aria-readonly="true" />
            </div>
            <div class="col-md-4">
                <label for="PreviousBalance" class="form-label">Previous balance (unpaid)</label>
                <input id="PreviousBalance" class="form-control" readonly aria-readonly="true" />
            </div>

            <div class="col-md-4">
                <label asp-for="DiscountAmount" class="form-label"></label>
                <input asp-for="DiscountAmount" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="EquipmentCharges" class="form-label"></label>
                <input asp-for="EquipmentCharges" type="number" step="0.01" class="form-control" />
                <div class="form-text">Filled from the equipment assigned to the connection.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="ReplacementCharges" class="form-label"></label>
                <input asp-for="ReplacementCharges" type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Generate Bill</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var connection = document.getElementById('ConnectionId');
            var fields = {
                monthlyRental: document.getElementById('MonthlyRental'),
                securityDeposit: document.getElementById('SecurityDeposit'),
                equipmentCharges: document.getElementById('EquipmentCharges'),
                previousBalance: document.getElementById('PreviousBalance')
            };
            var cardWrapper = document.getElementById('connectionCardWrapper');
            var card = document.getElementById('connectionCard');
            var defaultsUrl = '@Url.Action("BillDefaults", "Bills", new { area = "Accounts" })';

            function money(value) {
                return Number(value || 0).toFixed(2);
            }

            function display(value) {
                return 'PKR ' + Number(value || 0).toLocaleString('en-PK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function escapeHtml(value) {
                var div = document.createElement('div');
                div.textContent = value == null ? '' : value;
                return div.innerHTML;
            }

            function clearFields() {
                Object.values(fields).forEach(function (input) { input.value = ''; });
                cardWrapper.hidden = true;
                card.innerHTML = '';
            }

            function renderCard(data) {
                card.innerHTML =
                    '<a class="card p-4 text-reset text-decoration-none" href="' + data.detailsUrl + '">' +
                    '<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">' +
                    '<div><h6 class="mb-1">' + escapeHtml(data.customerName) + '</h6>' +
                    '<div class="text-muted small">' + escapeHtml(data.accountNumber) + ' &middot; ' + escapeHtml(data.planName) +
                    (data.cityName ? ' &middot; ' + escapeHtml(data.cityName) : '') + '</div></div>' +
                    '<span class="' + data.statusCss + '"><span class="status-pill__dot" aria-hidden="true"></span>' + escapeHtml(data.statusText) + '</span></div>' +
                    '<dl class="row detail-list mb-0 small">' +
                    '<dt class="col-6 col-md-3">Monthly rental</dt><dd class="col-6 col-md-3 text-price">' + display(data.monthlyRental) + '</dd>' +
                    '<dt class="col-6 col-md-3">Security deposit</dt><dd class="col-6 col-md-3 text-price">' + display(data.securityDeposit) + '</dd>' +
                    '<dt class="col-6 col-md-3">Previous balance</dt><dd class="col-6 col-md-3 text-price">' + display(data.previousBalance) + '</dd>' +
                    '<dt class="col-6 col-md-3">Previous bill</dt><dd class="col-6 col-md-3">' + (data.previousBillNumber ? escapeHtml(data.previousBillNumber) : '-') + '</dd>' +
                    '</dl>' +
                    '<span class="btn btn-sm btn-outline-primary mt-3">View connection details</span>' +
                    '</a>';
                cardWrapper.hidden = false;
            }

            function loadDefaults(forceEquipment) {
                if (!connection.value) {
                    clearFields();
                    return;
                }

                fetch(defaultsUrl + '?connectionId=' + encodeURIComponent(connection.value), {
                    headers: { 'Accept': 'application/json' }
                })
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(function (data) {
                        if (!data) {
                            clearFields();
                            return;
                        }

                        fields.monthlyRental.value = money(data.monthlyRental);
                        fields.securityDeposit.value = money(data.securityDeposit);
                        fields.previousBalance.value = money(data.previousBalance);
                        if (forceEquipment || !fields.equipmentCharges.value || Number(fields.equipmentCharges.value) === 0) {
                            fields.equipmentCharges.value = money(data.equipmentCharges);
                        }
                        renderCard(data);
                    })
                    .catch(clearFields);
            }

            connection.addEventListener('change', function () { loadDefaults(true); });
            loadDefaults(false);
        })();
    </script>
}
