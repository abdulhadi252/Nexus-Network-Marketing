@model Bill
@{
    ViewData["Title"] = "Bill Details";
    var lastNotification = ViewBag.LastNotification as CustomerNotification;
    var notificationCount = (int?)ViewBag.NotificationCount ?? 0;
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Accounts" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Bills</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">@Model.BillNumber</h1>
        <p class="page-subtitle">@Model.Customer.FirstName @Model.Customer.LastName &middot; @Model.Connection.AccountNumber &middot;
            <partial name="_StatusPill" model="@((object?)Model.Status)" /></p>
    </div>
    <div class="page-head__actions">
        @if (ViewBag.CanRecordPayment == true)
        {
        <a class="btn btn-primary" asp-controller="Payments" asp-action="Create" asp-route-billId="@Model.Id">+ Record Payment</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Back to bills</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">Bill Items</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Description</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Description</td>
                                    <td class="text-end text-price">PKR @item.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Total payable</th>
                                <th class="text-end text-price">PKR @((Model.TotalAmount + Model.PreviousBalance - Model.PreviousPaidAmount).ToString("N2"))</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Payments (@Model.Payments.Count)</div>
            <div class="card-body p-0">
                @if (Model.Payments.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No payments recorded against this bill.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Receipt</th><th>Date</th><th>Method</th><th>Reference</th><th>Amount</th><th>Recorded by</th></tr></thead>
                            <tbody>
                                @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaidAt))
                                {
                                    <tr>
                                        <td>@payment.ReceiptNumber</td>
                                        <td>@payment.PaidAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                        <td>@payment.Method</td>
                                        <td>@(payment.PaymentReference ?? "-")</td>
                                        <td class="text-price">PKR @payment.Amount.ToString("N2")</td>
                                        <td>@(payment.RecordedByEmployee is null ? "-" : $"{payment.RecordedByEmployee.FirstName} {payment.RecordedByEmployee.LastName}")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card p-4">
            <h6 class="mb-3">Summary</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-7">Billing period</dt>
                <dd class="col-5">@Model.BillingPeriodStart.ToString("dd MMM yyyy") - @Model.BillingPeriodEnd.ToString("dd MMM yyyy")</dd>
                <dt class="col-7">Due date</dt>
                <dd class="col-5">@Model.DueDate.ToString("dd MMM yyyy")</dd>
                <dt class="col-7">Monthly rental</dt>
                <dd class="col-5 text-price">PKR @Model.MonthlyRental.ToString("N2")</dd>
                <dt class="col-7">Equipment charges</dt>
                <dd class="col-5 text-price">PKR @Model.EquipmentCharges.ToString("N2")</dd>
                <dt class="col-7">Replacement charges</dt>
                <dd class="col-5 text-price">PKR @Model.ReplacementCharges.ToString("N2")</dd>
                <dt class="col-7">Discount</dt>
                <dd class="col-5 text-price">PKR @Model.DiscountAmount.ToString("N2")</dd>
                <dt class="col-7">Scheme discount</dt>
                <dd class="col-5 text-price">PKR @Model.SchemeDiscountAmount.ToString("N2")</dd>
                <dt class="col-7">Service tax (12.24%)</dt>
                <dd class="col-5 text-price">PKR @Model.ServiceTaxAmount.ToString("N2")</dd>
                <dt class="col-7">Previous balance</dt>
                <dd class="col-5 text-price">PKR @Model.PreviousBalance.ToString("N2")</dd>
                <dt class="col-7">Total</dt>
                <dd class="col-5 text-price">PKR @Model.TotalAmount.ToString("N2")</dd>
                <dt class="col-7">Paid</dt>
                <dd class="col-5 text-price">PKR @Model.PaidAmount.ToString("N2")</dd>
                <dt class="col-7 fw-bold">Due</dt>
                <dd class="col-5 text-price fw-bold">PKR @Model.DueAmount.ToString("N2")</dd>
                <dt class="col-7">Generated</dt>
                <dd class="col-5">@Model.GeneratedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
            </dl>
        </div>

        <div class="card p-4 mt-3">
            <h6 class="mb-3">Notify Customer</h6>
            <p class="text-muted small mb-2">
                Send this bill to <strong>@Model.Customer.FirstName @Model.Customer.LastName</strong>'s own
                customer panel. Sirf wohi customer isse dekhta hai, aur message se seedha <em>Pay now</em> khulta hai.
            </p>

            <p class="small mb-3">
                @if (lastNotification is null)
                {
                    <span class="badge bg-secondary">Not sent yet</span>
                }
                else
                {
                    <span class="badge bg-success">Sent</span>
                    <span class="text-muted">
                        @lastNotification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        &middot; @(lastNotification.IsRead ? "customer ne parh li" : "customer ne abhi nahi parhi")
                        @if (notificationCount > 1)
                        {
                            <text> &middot; @notificationCount times</text>
                        }
                    </span>
                }
            </p>

            @if (Model.DueAmount <= 0)
            {
                <p class="text-muted small mb-0">Is bill par koi outstanding due nahi hai, is liye notification ki zaroorat nahi.</p>
            }
            else
            {
                <form asp-action="NotifyCustomer" asp-route-id="@Model.Id" method="post" class="row g-2">
                    <div class="col-12">
                        <textarea name="message" class="form-control" rows="2" maxlength="1000"
                                  placeholder="Optional note for the customer (e.g. payment deadline)"></textarea>
                    </div>
                    <div class="col-12 d-grid">
                        <button type="submit" class="btn btn-primary">
                            <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-bell" /></svg>
                            @(lastNotification is null ? "Send bill notification" : "Resend bill notification")
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
