@model PagedResult<Bill>
@{
    ViewData["Title"] = "Outstanding Dues";
    var overdueOnly = (bool)(ViewData["overdueOnly"] ?? false);
    decimal totalOutstanding = ViewBag.TotalOutstanding ?? 0m;
    int overdueCount = ViewBag.OverdueCount ?? 0;
    decimal overdueAmount = ViewBag.OverdueAmount ?? 0m;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var reminderBills = ViewBag.ReminderBills as IReadOnlyList<Bill> ?? Array.Empty<Bill>();
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Accounts" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Outstanding Dues</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Outstanding Dues</h1>
        <p class="page-subtitle">Track unpaid and partially paid bills with their due dates.</p>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Total Outstanding</div>
            <div class="stat-value">PKR @totalOutstanding.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Overdue Bills</div>
            <div class="stat-value">@overdueCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Overdue Amount</div>
            <div class="stat-value text-danger">PKR @overdueAmount.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="mb-2">Send a payment reminder</h6>
        @if (reminderBills.Count == 0)
        {
            <p class="text-muted small mb-0">Every bill is paid, so there is nobody to remind right now.</p>
        }
        else
        {
            <p class="text-muted small mb-3">
                Pick a customer whose bill is still unpaid. Their bill details fill in by themselves and the note
                goes straight to that customer's own panel.
            </p>
            <form asp-action="SendReminder" method="post" class="row g-3">
                <div class="col-lg-7">
                    <label for="reminderBill" class="form-label">Customer / bill with outstanding due</label>
                    <select class="form-select" id="reminderBill" name="billId" required>
                        <option value="">-- Select a customer with outstanding dues --</option>
                        @foreach (var bill in reminderBills)
                        {
                            <option value="@bill.Id"
                                    data-customer="@bill.Customer.FirstName @bill.Customer.LastName"
                                    data-account="@bill.Connection.AccountNumber"
                                    data-bill="@bill.BillNumber"
                                    data-period="@bill.BillingPeriodStart.ToString("dd MMM yyyy") to @bill.BillingPeriodEnd.ToString("dd MMM yyyy")"
                                    data-due="@bill.DueAmount.ToString("N2")"
                                    data-duedate="@bill.DueDate.ToString("dd MMM yyyy")"
                                    data-phone="@bill.Customer.PrimaryContactNumber"
                                    data-email="@bill.Customer.Email">
                                @bill.Customer.FirstName @bill.Customer.LastName &middot; @bill.Connection.AccountNumber &middot; PKR @bill.DueAmount.ToString("N2") due
                            </option>
                        }
                    </select>
                </div>
                <div class="col-lg-5">
                    <div class="border rounded p-3 h-100" id="reminderDetails" hidden>
                        <dl class="row mb-0 small">
                            <dt class="col-5">Customer</dt><dd class="col-7 mb-1" id="reminderCustomer"></dd>
                            <dt class="col-5">Account</dt><dd class="col-7 mb-1" id="reminderAccount"></dd>
                            <dt class="col-5">Phone</dt><dd class="col-7 mb-1" id="reminderPhone"></dd>
                            <dt class="col-5">Email</dt><dd class="col-7 mb-1 text-break" id="reminderEmail"></dd>
                            <dt class="col-5">Bill</dt><dd class="col-7 mb-1" id="reminderBillNumber"></dd>
                            <dt class="col-5">Period</dt><dd class="col-7 mb-1" id="reminderPeriod"></dd>
                            <dt class="col-5">Outstanding</dt><dd class="col-7 mb-1 fw-semibold text-danger" id="reminderDue"></dd>
                            <dt class="col-5">Due date</dt><dd class="col-7 mb-0" id="reminderDueDate"></dd>
                        </dl>
                    </div>
                </div>
                <div class="col-12">
                    <label for="reminderMessage" class="form-label">Note to the customer (optional)</label>
                    <textarea name="message" id="reminderMessage" class="form-control" rows="2" maxlength="1000"
                              placeholder="e.g. Please clear the amount before the next billing cycle."></textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary" id="reminderSend" disabled>
                        <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-bell" /></svg>
                        Send reminder
                    </button>
                    <span class="text-muted small ms-2">The customer sees it in their panel bell and Notifications page.</span>
                </div>
            </form>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <input type="hidden" name="overdueOnly" value="@(overdueOnly ? "true" : "false")" />
            <div class="col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Account number or customer..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
            <div class="col-auto">
                <a class="btn @(overdueOnly ? "btn-primary" : "btn-outline-danger")" asp-action="Index" asp-route-overdueOnly="true">Overdue Only</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">&#9989;</div>
                <p class="mb-0">@(overdueOnly ? "No overdue bills." : "No outstanding dues.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Bill</th><th>Customer</th><th>Account</th><th>Due date</th><th>Total</th><th>Paid</th><th>Due</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Model.Items)
                        {
                            var overdue = bill.DueDate < today;
                            var daysOverdue = overdue ? today.DayNumber - bill.DueDate.DayNumber : 0;
                            <tr class="@(overdue ? "table-warning" : "")">
                                <td class="fw-semibold">@bill.BillNumber</td>
                                <td>@bill.Customer.FirstName @bill.Customer.LastName</td>
                                <td>@bill.Connection.AccountNumber</td>
                                <td>
                                    @bill.DueDate.ToString("dd MMM yyyy")
                                    @if (overdue)
                                    {
                                        <span class="badge bg-danger ms-1">@daysOverdue day(s) overdue</span>
                                    }
                                </td>
                                <td class="text-price">PKR @bill.TotalAmount.ToString("N2")</td>
                                <td class="text-price">PKR @bill.PaidAmount.ToString("N2")</td>
                                <td class="text-price">PKR @bill.DueAmount.ToString("N2")</td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-primary" asp-controller="Payments" asp-action="Create" asp-route-billId="@bill.Id">Collect</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var select = document.getElementById('reminderBill');
            var details = document.getElementById('reminderDetails');
            var send = document.getElementById('reminderSend');
            if (!select || !details) {
                return;
            }

            var targets = {
                reminderCustomer: 'customer',
                reminderAccount: 'account',
                reminderPhone: 'phone',
                reminderEmail: 'email',
                reminderBillNumber: 'bill',
                reminderPeriod: 'period',
                reminderDue: 'due',
                reminderDueDate: 'duedate'
            };

            // Every detail comes from the selected bill, so nothing is typed twice.
            function syncDetails() {
                var option = select.selectedOptions.length ? select.selectedOptions[0] : null;
                var chosen = select.value !== '' && option !== null;

                Object.keys(targets).forEach(function (id) {
                    var element = document.getElementById(id);
                    if (!element) {
                        return;
                    }

                    var value = chosen ? option.getAttribute('data-' + targets[id]) : '';
                    if (targets[id] === 'due' && value) {
                        value = 'PKR ' + value;
                    }
                    element.textContent = value || '-';
                });

                details.hidden = !chosen;
                if (send) {
                    send.disabled = !chosen;
                }
            }

            select.addEventListener('change', syncDetails);
            syncDetails();
        })();
    </script>
}
