@model Nexos_Network_System.Models.Customer
@{
    ViewData["Title"] = "Customer Billing";
    var outstanding = Model.Bills.SumLatestOutstanding();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.FirstName @Model.LastName</h1>
        <p class="text-muted mb-0">@Model.Email &middot; @Model.PrimaryContactNumber</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to customers</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Outstanding</div>
            <div class="stat-value @(outstanding > 0 ? "text-danger" : "text-success")">PKR @outstanding.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Bills</div>
            <div class="stat-value">@Model.Bills.Count</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Payments</div>
            <div class="stat-value">@Model.Payments.Count</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header">Connections</div>
            <div class="card-body p-0">
                @if (Model.Connections.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No connections.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Account</th><th>Plan</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var connection in Model.Connections)
                                {
                                    <tr>
                                        <td class="fw-semibold">@connection.AccountNumber</td>
                                        <td>@connection.Plan?.Name</td>
                                        <td><partial name="_Badge" model="@((object?)connection.Status)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header">Bills</div>
            <div class="card-body p-0">
                @if (Model.Bills.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No bills generated.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Bill</th><th>Due</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var bill in Model.Bills.OrderByDescending(b => b.GeneratedAt))
                                {
                                    <tr>
                                        <td>@bill.BillNumber</td>
                                        <td class="text-price">PKR @bill.DueAmount.ToString("N2")</td>
                                        <td><partial name="_Badge" model="@((object?)bill.Status)" /></td>
                                        <td class="table-actions">
                                            <a class="btn btn-outline-secondary" asp-controller="Bills" asp-action="Details" asp-route-id="@bill.Id">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Payment History</div>
            <div class="card-body p-0">
                @if (Model.Payments.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No payments recorded.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Receipt</th><th>Date</th><th>Method</th><th>Amount</th></tr></thead>
                            <tbody>
                                @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaidAt))
                                {
                                    <tr>
                                        <td>@payment.ReceiptNumber</td>
                                        <td>@payment.PaidAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                        <td>@payment.Method</td>
                                        <td class="text-price">PKR @payment.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
