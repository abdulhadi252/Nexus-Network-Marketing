@model DashboardStatsViewModel
@{
    ViewData["Title"] = "Accounts Dashboard";

    var dueBills = Model.DueBillsList;
    var recentPayments = Model.RecentPayments;
}

<div class="dash-head">
    <div>
        <h1>Accounts Dashboard</h1>
        <p>Welcome back, @Model.GreetingName! Billing, payments and outstanding dues.</p>
    </div>
    <div class="dash-period" title="Reporting period">
        <svg class="svg-icon"><use href="#i-calendar" /></svg>
        <span>@Model.PeriodLabel</span>
    </div>
</div>

@* ---------------------------------------------------------------- KPI cards *@
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--blue"><svg class="svg-icon"><use href="#i-bills" /></svg></span>
                <span class="kpi-card__label">Total Bills</span>
            </div>
            <div class="kpi-card__value">@Model.TotalBills.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--green"><svg class="svg-icon"><use href="#i-check-circle" /></svg></span>
                <span class="kpi-card__label">Paid Bills</span>
            </div>
            <div class="kpi-card__value">@Model.PaidBills.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--orange"><svg class="svg-icon"><use href="#i-clock" /></svg></span>
                <span class="kpi-card__label">Unpaid Bills</span>
            </div>
            <div class="kpi-card__value">@Model.DueBills.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--purple"><svg class="svg-icon"><use href="#i-percent" /></svg></span>
                <span class="kpi-card__label">Partially Paid</span>
            </div>
            <div class="kpi-card__value">@Model.PartiallyPaidBills.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--cyan"><svg class="svg-icon"><use href="#i-wallet" /></svg></span>
                <span class="kpi-card__label">Payments Received</span>
            </div>
            <div class="kpi-card__value">PKR @Model.PaymentsReceived.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--orange"><svg class="svg-icon"><use href="#i-dues" /></svg></span>
                <span class="kpi-card__label">Outstanding Amount</span>
            </div>
            <div class="kpi-card__value">PKR @Model.OutstandingAmount.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--blue"><svg class="svg-icon"><use href="#i-customers" /></svg></span>
                <span class="kpi-card__label">Customers</span>
            </div>
            <div class="kpi-card__value">@Model.TotalCustomers.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--navy"><svg class="svg-icon"><use href="#i-connections" /></svg></span>
                <span class="kpi-card__label">Active Connections</span>
            </div>
            <div class="kpi-card__value">@Model.ActiveConnections.ToString("N0")</div>
        </article>
    </div>
</div>

@* ---------------------------------------------------------------- Billing queues *@
<div class="row g-3">
    <div class="col-xl-6">
        <section class="dash-card h-100">
            <header class="dash-card__head">
                <span class="dash-card__icon"><svg class="svg-icon"><use href="#i-dues" /></svg></span>
                <div class="dash-card__heading">
                    <h2 class="dash-card__title">Bills With Outstanding Dues</h2>
                    <p class="dash-card__sub">Oldest due date first</p>
                </div>
                <a class="btn btn-sm btn-outline-primary order-card__cta ms-auto"
                   asp-controller="Dues" asp-action="Index">
                    Dues Report
                </a>
            </header>
            <div class="dash-card__body dash-card__body--flush">
                @if (dueBills.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-check-circle" /></svg></span>
                        <p class="empty-title">All collected</p>
                        <p class="mb-0">No outstanding dues. Everything is collected.</p>
                    </div>
                }
                else
                {
                    <ul class="order-list">
                        @foreach (var bill in dueBills)
                        {
                            <partial name="_BillRow" model="bill" />
                        }
                    </ul>
                }
            </div>
        </section>
    </div>

    <div class="col-xl-6">
        <section class="dash-card h-100">
            <header class="dash-card__head">
                <span class="dash-card__icon"><svg class="svg-icon"><use href="#i-wallet" /></svg></span>
                <div class="dash-card__heading">
                    <h2 class="dash-card__title">Recent Payments</h2>
                    <p class="dash-card__sub">Newest receipts first</p>
                </div>
                <a class="btn btn-sm btn-outline-primary order-card__cta ms-auto"
                   asp-controller="Payments" asp-action="Index">
                    View All
                </a>
            </header>
            <div class="dash-card__body dash-card__body--flush">
                @if (recentPayments.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-wallet" /></svg></span>
                        <p class="empty-title">No payments recorded yet.</p>
                        <a class="btn btn-sm btn-primary" asp-controller="Payments" asp-action="Create">Record the first payment</a>
                    </div>
                }
                else
                {
                    <ul class="order-list">
                        @foreach (var payment in recentPayments)
                        {
                            <partial name="_PaymentRow" model="payment" />
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
</div>
