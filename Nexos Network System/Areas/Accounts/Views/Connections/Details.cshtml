@model Connection
@{
    ViewData["Title"] = "Connection Billing";
    var outstanding = Model.Bills.SumLatestOutstanding();
    var latestBillId = Model.Bills
        .Where(b => b.Status != BillStatus.Cancelled)
        .OrderByDescending(b => b.BillingPeriodEnd)
        .ThenByDescending(b => b.GeneratedAt)
        .ThenByDescending(b => b.Id)
        .Select(b => (int?)b.Id)
        .FirstOrDefault();
    var totalBilled = Model.Bills.Sum(b => b.TotalAmount);
    var totalPaid = Model.Bills.Sum(b => b.PaidAmount);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.AccountNumber</h1>
        <p class="text-muted mb-0">
            @Model.Customer.FirstName @Model.Customer.LastName &middot; @Model.Plan?.Name &middot;
            <partial name="_Badge" model="@((object?)Model.Status)" />
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="Bills" asp-action="Generate" asp-route-connectionId="@Model.Id">+ Generate Bill</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to connections</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Total Billed</div>
            <div class="stat-value">PKR @totalBilled.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Total Paid</div>
            <div class="stat-value">PKR @totalPaid.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card card">
            <div class="stat-label">Outstanding</div>
            <div class="stat-value @(outstanding > 0 ? "text-danger" : "text-success")">PKR @outstanding.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Bills (@Model.Bills.Count)</div>
    <div class="card-body p-0">
        @if (Model.Bills.Count == 0)
        {
            <div class="empty-state">
                <p class="mb-2">No bills have been generated for this connection.</p>
                <a class="btn btn-sm btn-primary" asp-controller="Bills" asp-action="Generate" asp-route-connectionId="@Model.Id">Generate first bill</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Bill</th><th>Period</th><th>Due date</th><th>Total</th><th>Paid</th><th>Due</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Model.Bills.OrderByDescending(b => b.GeneratedAt))
                        {
                            <tr>
                                <td class="fw-semibold">@bill.BillNumber</td>
                                <td>@bill.BillingPeriodStart.ToString("MMM yyyy")</td>
                                <td>@bill.DueDate.ToString("dd MMM yyyy")</td>
                                <td class="text-price">PKR @bill.TotalAmount.ToString("N2")</td>
                                <td class="text-price">PKR @bill.PaidAmount.ToString("N2")</td>
                                <td class="text-price">PKR @bill.DueAmount.ToString("N2")</td>
                                <td><partial name="_Badge" model="@((object?)bill.Status)" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-controller="Bills" asp-action="Details" asp-route-id="@bill.Id">View</a>
                                    @if (bill.Id == latestBillId && bill.DueAmount > 0)
                                    {
                                        <a class="btn btn-outline-primary" asp-controller="Payments" asp-action="Create" asp-route-billId="@bill.Id">Collect</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
