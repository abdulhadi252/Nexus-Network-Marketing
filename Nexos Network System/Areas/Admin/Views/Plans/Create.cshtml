@model PlanFormViewModel
@{
    ViewData["Title"] = "New Plan";
}

<h1 class="h4 mb-1">New Plan</h1>
<p class="text-muted">Plans are stored in the database and used for orders, connections and billing.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ConnectionType" class="form-label"></label>
                <select asp-for="ConnectionType" class="form-select" asp-items="Html.GetEnumSelectList<ConnectionType>()"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="BillingCycle" class="form-label"></label>
                <select asp-for="BillingCycle" class="form-select" asp-items="Html.GetEnumSelectList<PlanBillingCycle>()"></select>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-3">
                <label asp-for="RecurringCharge" class="form-label"></label>
                <input asp-for="RecurringCharge" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="RecurringCharge" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="SecurityDeposit" class="form-label"></label>
                <input asp-for="SecurityDeposit" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="InstallationCharge" class="form-label"></label>
                <input asp-for="InstallationCharge" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="ValidityDays" class="form-label"></label>
                <input asp-for="ValidityDays" type="number" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="SpeedMbps" class="form-label"></label>
                <input asp-for="SpeedMbps" type="number" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="IncludedUsageHours" class="form-label"></label>
                <input asp-for="IncludedUsageHours" type="number" class="form-control" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Plan</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
