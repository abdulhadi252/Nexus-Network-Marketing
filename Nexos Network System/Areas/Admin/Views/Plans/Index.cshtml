@model PagedResult<Plan>
@{
    ViewData["Title"] = "Plans";
    var kpiTotal = (BillMetric?)ViewData["KpiTotal"];
    var kpiActive = (BillMetric?)ViewData["KpiActive"];
    var kpiConnections = (BillMetric?)ViewData["KpiConnections"];
    var kpiOrders = (BillMetric?)ViewData["KpiOrders"];
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Plans</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Plans</h1>
        <p class="page-subtitle">Service plans offered for dial-up, broadband and telephone connections.</p>
    </div>
    <div class="page-head__actions">
        <span class="count-chip">
            <svg class="svg-icon" aria-hidden="true"><use href="#i-plans" /></svg>
            @Model.TotalItems plan@(Model.TotalItems == 1 ? string.Empty : "s")
        </span>
        <a class="btn btn-primary" asp-action="Create">
            <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-plus" /></svg>
            New Plan
        </a>
    </div>
</div>

@if (kpiTotal is not null && kpiActive is not null && kpiConnections is not null && kpiOrders is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(kpiTotal, "Service Plans", "#i-plans", "blue", "in the catalogue")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(kpiActive, "Active Plans", "#i-check-circle", "green", "open for sale")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(kpiConnections, "Plan Connections", "#i-connections", "purple", "linked services")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(kpiOrders, "Orders on Plans", "#i-orders", "orange", "lifetime demand")' />
        </div>
    </div>
}

<section class="card directory">
    <div class="card-body">
        <header class="directory__head">
            <span class="directory__head-icon">
                <svg class="svg-icon" aria-hidden="true"><use href="#i-plans" /></svg>
            </span>
            <h2 class="directory__title">Plan Catalogue</h2>
        </header>

        <form method="get" class="toolbar directory__toolbar mb-0">
            <div class="search-bar directory__search">
                <svg class="search-icon svg-icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label class="visually-hidden" for="planSearch">Search plans</label>
                <input id="planSearch" type="search" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search plan name..." />
            </div>
            <button type="submit" class="btn btn-primary">
                <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-search" /></svg>
                Search
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index">
                <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-refresh" /></svg>
                Reset
            </a>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">
                    <svg class="svg-icon" aria-hidden="true"><use href="#i-plans" /></svg>
                </span>
                <p class="empty-title">No plans found</p>
                <p class="mb-0">Try a different search term or clear the filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle directory__table">
                    <thead>
                        <tr>
                            <th>Plan</th>
                            <th>Type</th>
                            <th>Cycle</th>
                            <th>Charge</th>
                            <th>Deposit</th>
                            <th>Speed / Hours</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@plan.Name</td>
                                <td>@plan.ConnectionType</td>
                                <td>@plan.BillingCycle</td>
                                <td class="text-price">PKR @plan.RecurringCharge.ToString("N2")</td>
                                <td class="text-price">PKR @plan.SecurityDeposit.ToString("N2")</td>
                                <td>
                                    @if (plan.SpeedMbps.HasValue)
                                    {
                                        @($"{plan.SpeedMbps} Mbps")
                                    }
                                    else if (plan.IncludedUsageHours.HasValue)
                                    {
                                        @($"{plan.IncludedUsageHours} hrs")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-pill @(plan.IsActive ? "status-pill--positive" : "status-pill--neutral")">
                                        <span class="status-pill__dot" aria-hidden="true"></span>
                                        @(plan.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="row-actions">
                                        <a class="icon-btn" asp-action="Details" asp-route-id="@plan.Id" aria-label="View plan @plan.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-eye" /></svg>
                                        </a>
                                        <a class="icon-btn" asp-action="Edit" asp-route-id="@plan.Id" aria-label="Edit plan @plan.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-edit" /></svg>
                                        </a>
                                        <a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@plan.Id" aria-label="Delete plan @plan.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@plan.Id" method="post" class="d-inline">
                                            <button type="submit" class="icon-btn" title="@(plan.IsActive ? "Deactivate" : "Activate")"
                                                    aria-label="@(plan.IsActive ? "Deactivate" : "Activate") plan @plan.Name">
                                                <svg class="svg-icon" aria-hidden="true"><use href="#i-refresh" /></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</section>
