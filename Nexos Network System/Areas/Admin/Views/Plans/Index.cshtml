@model PagedResult<Plan>
@{
    ViewData["Title"] = "Plans";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Plans</h1>
        <p class="text-muted mb-0">Service plans offered for dial-up, broadband and telephone connections.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ New Plan</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search plan name..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No plans found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Plan</th>
                            <th>Type</th>
                            <th>Cycle</th>
                            <th>Charge</th>
                            <th>Deposit</th>
                            <th>Speed / Hours</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@plan.Name</td>
                                <td>@plan.ConnectionType</td>
                                <td>@plan.BillingCycle</td>
                                <td class="text-price">PKR @plan.RecurringCharge.ToString("N2")</td>
                                <td class="text-price">PKR @plan.SecurityDeposit.ToString("N2")</td>
                                <td>
                                    @if (plan.SpeedMbps.HasValue)
                                    {
                                        @($"{plan.SpeedMbps} Mbps")
                                    }
                                    else if (plan.IncludedUsageHours.HasValue)
                                    {
                                        @($"{plan.IncludedUsageHours} hrs")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><partial name="_Badge" model="@((object?)(plan.IsActive ? "Active" : "Inactive"))" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@plan.Id">View</a>
                                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@plan.Id">Edit</a>
                                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@plan.Id">Delete</a>
                                    <form asp-action="ToggleActive" asp-route-id="@plan.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-warning">@(plan.IsActive ? "Deactivate" : "Activate")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
