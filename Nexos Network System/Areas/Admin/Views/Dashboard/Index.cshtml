@model DashboardStatsViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="h4 mb-1">Dashboard</h1>
<p class="text-muted">Live operational statistics from the database.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-customers" /></svg></span>
            <div class="stat-label">Total Customers</div>
            <div class="stat-value">@Model.TotalCustomers</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-employees" /></svg></span>
            <div class="stat-label">Employees</div>
            <div class="stat-value">@Model.TotalEmployees</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-shops" /></svg></span>
            <div class="stat-label">Retail Shops</div>
            <div class="stat-value">@Model.TotalRetailShops</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-vendors" /></svg></span>
            <div class="stat-label">Vendors</div>
            <div class="stat-value">@Model.TotalVendors</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-products" /></svg></span>
            <div class="stat-label">Products</div>
            <div class="stat-value">@Model.TotalProducts</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-plans" /></svg></span>
            <div class="stat-label">Plans</div>
            <div class="stat-value">@Model.TotalPlans</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-orders" /></svg></span>
            <div class="stat-label">Orders</div>
            <div class="stat-value">@Model.TotalOrders <span class="text-muted small">(@Model.PendingOrders pending)</span></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-connections" /></svg></span>
            <div class="stat-label">Connections</div>
            <div class="stat-value">@Model.ActiveConnections <span class="text-muted small">(@Model.PendingConnections pending)</span></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-bills" /></svg></span>
            <div class="stat-label">Total Bills</div>
            <div class="stat-value">@Model.TotalBills <span class="text-muted small">(@Model.DueBills with dues)</span></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-wallet" /></svg></span>
            <div class="stat-label">Outstanding Amount</div>
            <div class="stat-value">PKR @Model.OutstandingAmount.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-trending-up" /></svg></span>
            <div class="stat-label">Payments Received</div>
            <div class="stat-value">PKR @Model.PaymentsReceived.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-dues" /></svg></span>
            <div class="stat-label">Low Stock Items</div>
            <div class="stat-value">@Model.LowStockItems</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Orders</span>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Orders" asp-action="Index">View all</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentOrders.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No orders have been placed yet.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>Order</th><th>Customer</th><th>Type</th><th>Status</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-semibold">@order.OrderNumber</td>
                                        <td>@order.Customer.FirstName @order.Customer.LastName</td>
                                        <td>@order.ConnectionType</td>
                                        <td><partial name="_Badge" model="@((object?)order.Status)" /></td>
                                        <td class="table-actions">
                                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Payments</span>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Payments" asp-action="Index">View all</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentPayments.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No payments recorded yet.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Receipt</th><th>Customer</th><th>Amount</th></tr></thead>
                            <tbody>
                                @foreach (var payment in Model.RecentPayments)
                                {
                                    <tr>
                                        <td>@payment.ReceiptNumber</td>
                                        <td>@payment.Customer.FirstName @payment.Customer.LastName</td>
                                        <td class="text-price">PKR @payment.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Low Stock</span>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Stock" asp-action="Index" asp-route-lowOnly="true">View all</a>
            </div>
            <div class="card-body p-0">
                @if (Model.LowStock.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">All stock levels are healthy.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Product</th><th>On hand</th><th>Reorder level</th></tr></thead>
                            <tbody>
                                @foreach (var stock in Model.LowStock)
                                {
                                    <tr>
                                        <td>@stock.Product.Name</td>
                                        <td>@stock.QuantityOnHand</td>
                                        <td>@stock.ReorderLevel</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
