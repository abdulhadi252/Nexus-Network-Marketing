@model Employee
@{
    ViewData["Title"] = "Deactivate Employee";
}

<h1 class="h4 mb-1">Deactivate Employee</h1>
<p class="text-muted">Records are never hard deleted, so order, feasibility and payment history stays intact.</p>

<div class="card">
    <div class="card-body">
        <dl class="row detail-list">
            <dt class="col-sm-4">Employee number</dt>
            <dd class="col-sm-8">@Model.EmployeeNumber</dd>
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>
            <dt class="col-sm-4">Role</dt>
            <dd class="col-sm-8">@Model.Role</dd>
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">Retail shop</dt>
            <dd class="col-sm-8">@(Model.RetailShop?.Name ?? "Head office")</dd>
        </dl>

        <div class="alert alert-warning small">
            The employee will be marked inactive and will no longer appear as an active staff member.
            Historical records remain linked to this employee.
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Deactivate Employee</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
