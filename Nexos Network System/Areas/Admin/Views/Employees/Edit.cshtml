@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Edit Employee";
}

<h1 class="h4 mb-1">Edit Employee</h1>
<p class="text-muted">Update the staff record for @Model.FirstName @Model.LastName.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="col-md-4">
                <label asp-for="EmployeeNumber" class="form-label"></label>
                <input asp-for="EmployeeNumber" class="form-control" />
                <span asp-validation-for="EmployeeNumber" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactNumber" class="form-label"></label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select" asp-items="ViewBag.EmployeeRoles"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="RetailShopId" class="form-label"></label>
                <select asp-for="RetailShopId" class="form-select" asp-items="ViewBag.RetailShops">
                    <option value="">-- Head office --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="HireDate" class="form-label"></label>
                <input asp-for="HireDate" type="date" class="form-control" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
