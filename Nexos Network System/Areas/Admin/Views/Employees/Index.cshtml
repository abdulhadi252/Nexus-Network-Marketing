@model PagedResult<Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Employees</h1>
        <p class="text-muted mb-0">Staff accounts for admin, retail, technical and accounts roles.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ New Employee</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search name, number, email..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">&#128100;</div>
                <p class="mb-0">No employees match your search.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Employee #</th>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Retail Shop</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@employee.EmployeeNumber</td>
                                <td>
                                    @employee.FirstName @employee.LastName
                                    <div class="text-muted small">@employee.Email</div>
                                </td>
                                <td><span class="badge bg-primary">@employee.Role</span></td>
                                <td>@(employee.RetailShop?.Name ?? "Head office")</td>
                                <td>@employee.ContactNumber</td>
                                <td><partial name="_Badge" model="@((object?)(employee.IsActive ? "Active" : "Inactive"))" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@employee.Id">View</a>
                                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@employee.Id">Edit</a>
                                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@employee.Id">Deactivate</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
