@model Product
@{
    ViewData["Title"] = "Delete Product";
}

<h1 class="h4 mb-1">Delete Product</h1>
<p class="text-muted">Products referenced by orders or equipment are deactivated instead of deleted.</p>

<div class="card">
    <div class="card-body">
        <dl class="row detail-list">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Vendor</dt>
            <dd class="col-sm-8">@Model.Vendor?.Name</dd>
            <dt class="col-sm-4">Unit</dt>
            <dd class="col-sm-8">@Model.UnitOfMeasure</dd>
            <dt class="col-sm-4">Order items</dt>
            <dd class="col-sm-8">@Model.OrderItems.Count</dd>
            <dt class="col-sm-4">Equipment units</dt>
            <dd class="col-sm-8">@Model.EquipmentItems.Count</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete / Deactivate Product</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
