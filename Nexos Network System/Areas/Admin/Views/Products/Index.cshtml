@model PagedResult<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Products</h1>
        <p class="text-muted mb-0">Catalogue of equipment and materials sold or assigned to customers.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ New Product</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search product name..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No products found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Vendor</th>
                            <th>Unit</th>
                            <th>Cost</th>
                            <th>Sale price</th>
                            <th>On hand</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@product.Name</td>
                                <td>@product.Vendor?.Name</td>
                                <td>@product.UnitOfMeasure</td>
                                <td class="text-price">PKR @product.UnitCost.ToString("N2")</td>
                                <td class="text-price">@(product.UnitSalePrice.HasValue ? $"PKR {product.UnitSalePrice.Value:N2}" : "-")</td>
                                <td>
                                    @if (product.Stock is null)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else if (product.Stock.QuantityOnHand <= product.Stock.ReorderLevel)
                                    {
                                        <span class="badge bg-danger">@product.Stock.QuantityOnHand</span>
                                    }
                                    else
                                    {
                                        <span>@product.Stock.QuantityOnHand</span>
                                    }
                                </td>
                                <td><partial name="_Badge" model="@((object?)(product.IsActive ? "Active" : "Inactive"))" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@product.Id">View</a>
                                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@product.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
