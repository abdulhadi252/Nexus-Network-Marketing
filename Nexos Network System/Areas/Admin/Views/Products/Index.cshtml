@model PagedResult<Product>
@{
    ViewData["Title"] = "Products";
    var kpiTotal = (BillMetric?)ViewData["KpiTotal"];
    var kpiActive = (BillMetric?)ViewData["KpiActive"];
    var kpiLow = (BillMetric?)ViewData["KpiLow"];
    var kpiOnHand = (BillMetric?)ViewData["KpiOnHand"];
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Products</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Products</h1>
        <p class="page-subtitle">Catalogue of equipment and materials sold or assigned to customers.</p>
    </div>
    <div class="page-head__actions">
        <span class="count-chip">
            <svg class="svg-icon" aria-hidden="true"><use href="#i-products" /></svg>
            @Model.TotalItems product@(Model.TotalItems == 1 ? string.Empty : "s")
        </span>
        <a class="btn btn-primary" asp-action="Create">
            <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-plus" /></svg>
            New Product
        </a>
    </div>
</div>

@if (kpiTotal is not null && kpiActive is not null && kpiLow is not null && kpiOnHand is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(kpiTotal, "Products", "#i-products", "blue", "in the catalogue")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(kpiActive, "Active Products", "#i-check-circle", "green", "on sale")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(kpiLow, "Low Stock", "#i-stock", "orange", "at or below reorder")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(kpiOnHand, "Units On Hand", "#i-package", "purple", "across warehouses")' />
        </div>
    </div>
}

<section class="card directory">
    <div class="card-body">
        <header class="directory__head">
            <span class="directory__head-icon">
                <svg class="svg-icon" aria-hidden="true"><use href="#i-products" /></svg>
            </span>
            <h2 class="directory__title">Product Catalogue</h2>
        </header>

        <form method="get" class="toolbar directory__toolbar mb-0">
            <div class="search-bar directory__search">
                <svg class="search-icon svg-icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label class="visually-hidden" for="productSearch">Search products</label>
                <input id="productSearch" type="search" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search product name..." />
            </div>
            <button type="submit" class="btn btn-primary">
                <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-search" /></svg>
                Search
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index">
                <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-refresh" /></svg>
                Reset
            </a>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">
                    <svg class="svg-icon" aria-hidden="true"><use href="#i-products" /></svg>
                </span>
                <p class="empty-title">No products found</p>
                <p class="mb-0">Try a different search term or clear the filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle directory__table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Vendor</th>
                            <th>Unit</th>
                            <th>Cost</th>
                            <th>Sale price</th>
                            <th>On hand</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@product.Name</td>
                                <td>@product.Vendor?.Name</td>
                                <td>@product.UnitOfMeasure</td>
                                <td class="text-price">PKR @product.UnitCost.ToString("N2")</td>
                                <td class="text-price">@(product.UnitSalePrice.HasValue ? $"PKR {product.UnitSalePrice.Value:N2}" : "-")</td>
                                <td>
                                    @if (product.Stock is null)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else if (product.Stock.QuantityOnHand <= product.Stock.ReorderLevel)
                                    {
                                        <span class="badge bg-danger">@product.Stock.QuantityOnHand</span>
                                    }
                                    else
                                    {
                                        <span>@product.Stock.QuantityOnHand</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-pill @(product.IsActive ? "status-pill--positive" : "status-pill--neutral")">
                                        <span class="status-pill__dot" aria-hidden="true"></span>
                                        @(product.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="row-actions">
                                        <a class="icon-btn" asp-action="Details" asp-route-id="@product.Id" aria-label="View product @product.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-eye" /></svg>
                                        </a>
                                        <a class="icon-btn" asp-action="Edit" asp-route-id="@product.Id" aria-label="Edit product @product.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-edit" /></svg>
                                        </a>
                                        <a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@product.Id" aria-label="Delete product @product.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</section>
