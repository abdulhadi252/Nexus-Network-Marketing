@model ProductFormViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<h1 class="h4 mb-1">Edit Product</h1>
<p class="text-muted">Update catalogue details for @Model.Name. Quantities are changed in the Stock module.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="VendorId" class="form-label"></label>
                <select asp-for="VendorId" class="form-select" asp-items="ViewBag.Vendors">
                    <option value="">-- Select vendor --</option>
                </select>
            </div>
            <div class="col-md-8">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-4">
                <label asp-for="UnitOfMeasure" class="form-label"></label>
                <input asp-for="UnitOfMeasure" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="UnitCost" class="form-label"></label>
                <input asp-for="UnitCost" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="UnitSalePrice" class="form-label"></label>
                <input asp-for="UnitSalePrice" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="ReorderLevel" class="form-label"></label>
                <input asp-for="ReorderLevel" type="number" class="form-control" />
                <div class="form-text">Current on-hand quantity: <strong>@Model.OpeningQuantity</strong> (manage via Stock module)</div>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
