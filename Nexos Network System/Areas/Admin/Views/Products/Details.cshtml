@model Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">Supplied by @Model.Vendor?.Name &middot; @Model.UnitOfMeasure</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="Stock" asp-action="Movements" asp-route-id="@Model.Id">Stock Movements</a>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card p-4 h-100">
            <h6 class="mb-3">Product Information</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-5">Description</dt>
                <dd class="col-7">@(Model.Description ?? "-")</dd>
                <dt class="col-5">Unit cost</dt>
                <dd class="col-7 text-price">PKR @Model.UnitCost.ToString("N2")</dd>
                <dt class="col-5">Sale price</dt>
                <dd class="col-7 text-price">@(Model.UnitSalePrice.HasValue ? $"PKR {Model.UnitSalePrice.Value:N2}" : "-")</dd>
                <dt class="col-5">Status</dt>
                <dd class="col-7"><partial name="_Badge" model="@((object?)(Model.IsActive ? "Active" : "Inactive"))" /></dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card p-4 h-100">
            <h6 class="mb-3">Stock</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-7">On hand</dt>
                <dd class="col-5">@(Model.Stock?.QuantityOnHand.ToString() ?? "-")</dd>
                <dt class="col-7">Reserved</dt>
                <dd class="col-5">@(Model.Stock?.QuantityReserved.ToString() ?? "-")</dd>
                <dt class="col-7">Available</dt>
                <dd class="col-5">@((Model.Stock is null ? "-" : (Model.Stock.QuantityOnHand - Model.Stock.QuantityReserved).ToString()))</dd>
                <dt class="col-7">Reorder level</dt>
                <dd class="col-5">@(Model.Stock?.ReorderLevel.ToString() ?? "-")</dd>
            </dl>
            <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="Stock" asp-action="Adjust" asp-route-id="@Model.Id">Adjust Stock</a>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card p-4 h-100">
            <h6 class="mb-3">Equipment Units (@Model.EquipmentItems.Count)</h6>
            @if (Model.EquipmentItems.Count == 0)
            {
                <p class="text-muted small mb-0">No individual equipment units are registered for this product.</p>
            }
            else
            {
                <ul class="list-unstyled small mb-0">
                    @foreach (var equipment in Model.EquipmentItems.Take(8))
                    {
                        <li class="mb-1 d-flex justify-content-between align-items-center">
                            <span>@equipment.AssetTag (@equipment.SerialNumber)</span>
                            <partial name="_Badge" model="@((object?)equipment.Status)" />
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
