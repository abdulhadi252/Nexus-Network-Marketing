@model Vendor
@{
    ViewData["Title"] = "Vendor Details";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.ContactNumber</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card p-4 h-100">
            <h6 class="mb-3">Vendor Information</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-5">Email</dt>
                <dd class="col-7">@(Model.Email ?? "-")</dd>
                <dt class="col-5">Address</dt>
                <dd class="col-7">@(Model.Address ?? "-")</dd>
                <dt class="col-5">Products</dt>
                <dd class="col-7">@Model.Products.Count</dd>
                <dt class="col-5">Equipment units</dt>
                <dd class="col-7">@Model.EquipmentItems.Count</dd>
                <dt class="col-5">Status</dt>
                <dd class="col-7"><partial name="_Badge" model="@((object?)(Model.IsActive ? "Active" : "Inactive"))" /></dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Supplied Products</div>
            <div class="card-body p-0">
                @if (Model.Products.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No products linked to this vendor.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Product</th><th>Unit</th><th>Cost</th><th>Sale price</th></tr></thead>
                            <tbody>
                                @foreach (var product in Model.Products)
                                {
                                    <tr>
                                        <td>@product.Name</td>
                                        <td>@product.UnitOfMeasure</td>
                                        <td class="text-price">PKR @product.UnitCost.ToString("N2")</td>
                                        <td class="text-price">@(product.UnitSalePrice.HasValue ? $"PKR {product.UnitSalePrice.Value:N2}" : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
