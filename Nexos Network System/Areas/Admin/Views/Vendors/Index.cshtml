@model PagedResult<Vendor>
@{
    ViewData["Title"] = "Vendors";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Vendors</h1>
        <p class="text-muted mb-0">Suppliers of products and equipment.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ New Vendor</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search vendor name or phone..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No vendors found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Name</th><th>Contact</th><th>Email</th><th>Products</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var vendor in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@vendor.Name</td>
                                <td>@vendor.ContactNumber</td>
                                <td>@(vendor.Email ?? "-")</td>
                                <td>@vendor.Products.Count</td>
                                <td><partial name="_Badge" model="@((object?)(vendor.IsActive ? "Active" : "Inactive"))" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@vendor.Id">View</a>
                                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@vendor.Id">Edit</a>
                                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@vendor.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
