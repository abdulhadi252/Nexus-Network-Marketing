@model PagedResult<Vendor>
@{
    ViewData["Title"] = "Vendors";
    var totalVendors = (BillMetric?)ViewData["KpiTotal"];
    var activeVendors = (BillMetric?)ViewData["KpiActive"];
    var productCount = (BillMetric?)ViewData["KpiProducts"];
    var equipmentCount = (BillMetric?)ViewData["KpiEquipment"];
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Vendors</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Vendors</h1>
        <p class="page-subtitle">Suppliers of products and equipment.</p>
    </div>
    <div class="page-head__actions">
        <span class="count-chip">
            <svg class="svg-icon" aria-hidden="true"><use href="#i-vendors" /></svg>
            @Model.TotalItems vendor@(Model.TotalItems == 1 ? string.Empty : "s")
        </span>
        <a class="btn btn-primary" asp-action="Create">
            <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-plus" /></svg>
            New Vendor
        </a>
    </div>
</div>

@if (totalVendors is not null && activeVendors is not null && productCount is not null && equipmentCount is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(totalVendors, "Total Vendors", "#i-vendors", "blue", "on record")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(activeVendors, "Active Vendors", "#i-check-circle", "green", "in supply")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(productCount, "Catalogue Products", "#i-products", "purple", "linked items")' />
        </div>
        <div class="col-12 col-md-3">
            <partial name="_AdminKpiRow" model='(equipmentCount, "Equipment Items", "#i-equipment", "orange", "tracked units")' />
        </div>
    </div>
}

<section class="card directory">
    <div class="card-body">
        <header class="directory__head">
            <span class="directory__head-icon">
                <svg class="svg-icon" aria-hidden="true"><use href="#i-vendors" /></svg>
            </span>
            <h2 class="directory__title">Vendor Directory</h2>
        </header>

        <form method="get" class="toolbar directory__toolbar mb-0">
            <div class="search-bar directory__search">
                <svg class="search-icon svg-icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label class="visually-hidden" for="vendorSearch">Search vendors</label>
                <input id="vendorSearch" type="search" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search vendor name or phone..." />
            </div>
            <button type="submit" class="btn btn-primary">
                <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-search" /></svg>
                Search
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index">
                <svg class="svg-icon btn-icon" aria-hidden="true"><use href="#i-refresh" /></svg>
                Reset
            </a>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">
                    <svg class="svg-icon" aria-hidden="true"><use href="#i-vendors" /></svg>
                </span>
                <p class="empty-title">No vendors found</p>
                <p class="mb-0">Try a different search term or clear the filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle directory__table">
                    <thead>
                        <tr><th>Name</th><th>Contact</th><th>Email</th><th>Products</th><th>Status</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var vendor in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@vendor.Name</td>
                                <td>@vendor.ContactNumber</td>
                                <td>@(vendor.Email ?? "-")</td>
                                <td>@vendor.Products.Count</td>
                                <td>
                                    <span class="status-pill @(vendor.IsActive ? "status-pill--positive" : "status-pill--neutral")">
                                        <span class="status-pill__dot" aria-hidden="true"></span>
                                        @(vendor.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="row-actions">
                                        <a class="icon-btn" asp-action="Details" asp-route-id="@vendor.Id" aria-label="View vendor @vendor.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-eye" /></svg>
                                        </a>
                                        <a class="icon-btn" asp-action="Edit" asp-route-id="@vendor.Id" aria-label="Edit vendor @vendor.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-edit" /></svg>
                                        </a>
                                        <a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@vendor.Id" aria-label="Delete vendor @vendor.Name">
                                            <svg class="svg-icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</section>
