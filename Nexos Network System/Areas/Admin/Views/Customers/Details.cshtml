@model Customer
@{
    ViewData["Title"] = "Customer Details";
    var primaryAddress = Model.Addresses.OrderByDescending(a => a.IsPrimary).FirstOrDefault();
    var outstanding = Model.Bills.SumLatestOutstanding();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.FirstName @Model.LastName</h1>
        <p class="text-muted mb-0">@Model.Email &middot; @Model.PrimaryContactNumber</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card p-4 h-100">
            <h6 class="mb-3">Personal &amp; Address</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-5">National ID</dt>
                <dd class="col-7">@(Model.NationalId ?? "Not provided")</dd>
                <dt class="col-5">Alternate contact</dt>
                <dd class="col-7">@(Model.AlternateContactNumber ?? "-")</dd>
                <dt class="col-5">Address</dt>
                <dd class="col-7">
                    @(primaryAddress is null ? "Not provided"
                        : $"{primaryAddress.AddressLine1}{(string.IsNullOrEmpty(primaryAddress.AddressLine2) ? "" : ", " + primaryAddress.AddressLine2)}, {primaryAddress.City?.Name}")
                </dd>
                <dt class="col-5">Postal code</dt>
                <dd class="col-7">@(primaryAddress?.PostalCode ?? "-")</dd>
                <dt class="col-5">Status</dt>
                <dd class="col-7"><partial name="_Badge" model="@((object?)(Model.IsActive ? "Active" : "Inactive"))" /></dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="row g-3 h-100">
            <div class="col-6">
                <div class="stat-card card h-100">
                    <div class="stat-label">Orders</div>
                    <div class="stat-value">@Model.Orders.Count</div>
                </div>
            </div>
            <div class="col-6">
                <div class="stat-card card h-100">
                    <div class="stat-label">Connections</div>
                    <div class="stat-value">@Model.Connections.Count</div>
                </div>
            </div>
            <div class="col-6">
                <div class="stat-card card h-100">
                    <div class="stat-label">Outstanding</div>
                    <div class="stat-value text-price">PKR @outstanding.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6">
                <div class="stat-card card h-100">
                    <div class="stat-label">Payments</div>
                    <div class="stat-value">@Model.Payments.Count</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Orders</div>
            <div class="card-body p-0">
                @if (Model.Orders.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No orders yet.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Order</th><th>Type</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var order in Model.Orders.OrderByDescending(o => o.SubmittedAt).Take(10))
                                {
                                    <tr>
                                        <td class="fw-semibold">@order.OrderNumber</td>
                                        <td>@order.ConnectionType</td>
                                        <td><partial name="_Badge" model="@((object?)order.Status)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Connections</div>
            <div class="card-body p-0">
                @if (Model.Connections.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No connections yet.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Account</th><th>Plan</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var connection in Model.Connections)
                                {
                                    <tr>
                                        <td class="fw-semibold">@connection.AccountNumber</td>
                                        <td>@connection.Plan?.Name</td>
                                        <td><partial name="_Badge" model="@((object?)connection.Status)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
