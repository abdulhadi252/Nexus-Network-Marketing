@model CustomerFormViewModel
@{
    ViewData["Title"] = "New Customer";
}

<h1 class="h4 mb-1">New Customer</h1>
<p class="text-muted">Register a new customer with their primary address.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="col-md-4">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NationalId" class="form-label"></label>
                <input asp-for="NationalId" class="form-control" placeholder="42101-1234567-1 (optional)" />
                <span asp-validation-for="NationalId" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="PrimaryContactNumber" class="form-label"></label>
                <input asp-for="PrimaryContactNumber" class="form-control" />
                <span asp-validation-for="PrimaryContactNumber" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AlternateContactNumber" class="form-label"></label>
                <input asp-for="AlternateContactNumber" class="form-control" />
                <span asp-validation-for="AlternateContactNumber" class="field-validation-error"></span>
            </div>

            <h6 class="text-muted mt-2 mb-0">Primary Address</h6>

            <div class="col-md-4">
                <label asp-for="CityId" class="form-label"></label>
                <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities">
                    <option value="">-- Select city --</option>
                </select>
                <span asp-validation-for="CityId" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AddressLine1" class="form-label"></label>
                <input asp-for="AddressLine1" class="form-control" />
                <span asp-validation-for="AddressLine1" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AddressLine2" class="form-label"></label>
                <input asp-for="AddressLine2" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="PostalCode" class="form-label"></label>
                <input asp-for="PostalCode" class="form-control" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Customer</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
