@model PagedResult<Connection>
@{
    ViewData["Title"] = "Connections";
}

<h1 class="h4 mb-1">Connections</h1>
<p class="text-muted">All customer connections with their account numbers and live status.</p>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Account number or customer name" />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<ConnectionStatus>())
                    {
                        <option value="@status" selected="@(ViewData["status"]?.ToString() == status.ToString())">@status</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No connections match your search.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Account Number</th>
                            <th>Customer</th>
                            <th>Type</th>
                            <th>Plan</th>
                            <th>City</th>
                            <th>Activated</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var connection in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@connection.AccountNumber</td>
                                <td>@connection.Customer.FirstName @connection.Customer.LastName</td>
                                <td>@connection.ConnectionType</td>
                                <td>@connection.Plan?.Name</td>
                                <td>@connection.City?.Name</td>
                                <td>@(connection.ActivatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "-")</td>
                                <td><partial name="_Badge" model="@((object?)connection.Status)" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@connection.Id">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
