@model RetailShop
@{
    ViewData["Title"] = "Shop Details";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.City?.Name</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card p-4 h-100">
            <h6 class="mb-3">Shop Information</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-5">Contact number</dt>
                <dd class="col-7">@Model.ContactNumber</dd>
                <dt class="col-5">Address</dt>
                <dd class="col-7">@Model.AddressLine1@(string.IsNullOrEmpty(Model.AddressLine2) ? "" : ", " + Model.AddressLine2)</dd>
                <dt class="col-5">City</dt>
                <dd class="col-7">@Model.City?.Name (@Model.City?.Code)</dd>
                <dt class="col-5">Status</dt>
                <dd class="col-7"><partial name="_Badge" model="@((object?)(Model.IsActive ? "Active" : "Inactive"))" /></dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">Employees (@Model.Employees.Count)</div>
            <div class="card-body p-0">
                @if (Model.Employees.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No employees assigned.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Name</th><th>Role</th><th>Contact</th></tr></thead>
                            <tbody>
                                @foreach (var employee in Model.Employees)
                                {
                                    <tr>
                                        <td>@employee.FirstName @employee.LastName</td>
                                        <td><span class="badge bg-primary">@employee.Role</span></td>
                                        <td>@employee.ContactNumber</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header">Recent Orders (@Model.Orders.Count total)</div>
            <div class="card-body p-0">
                @if (Model.Orders.Count == 0)
                {
                    <div class="empty-state"><p class="mb-0">No orders placed at this branch.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Order</th><th>Status</th><th>Submitted</th></tr></thead>
                            <tbody>
                                @foreach (var order in Model.Orders.OrderByDescending(o => o.SubmittedAt).Take(8))
                                {
                                    <tr>
                                        <td class="fw-semibold">@order.OrderNumber</td>
                                        <td><partial name="_Badge" model="@((object?)order.Status)" /></td>
                                        <td>@order.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
