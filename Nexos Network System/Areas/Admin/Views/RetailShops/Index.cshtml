@model PagedResult<RetailShop>
@{
    ViewData["Title"] = "Retail Shops";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Retail Shops</h1>
        <p class="text-muted mb-0">Branches where customers are registered and orders are placed.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ New Shop</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search shop name or phone..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No shops found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Name</th><th>City</th><th>Contact</th><th>Employees</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var shop in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@shop.Name</td>
                                <td>@shop.City?.Name</td>
                                <td>@shop.ContactNumber</td>
                                <td>@shop.Employees.Count</td>
                                <td><partial name="_Badge" model="@((object?)(shop.IsActive ? "Active" : "Inactive"))" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@shop.Id">View</a>
                                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@shop.Id">Edit</a>
                                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@shop.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
