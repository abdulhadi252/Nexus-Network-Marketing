@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="section">
    <div class="container" style="max-width: 720px;">
        <div class="card p-4 p-md-5">
            <div class="text-center mb-4">
                <h3 class="fw-bold mb-1">Create your account</h3>
                <p class="text-muted small mb-0">Register as a NEXUS customer. You will be able to log in right away.</p>
            </div>

            <form asp-area="Identity" asp-controller="Account" asp-action="Register" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactNumber" class="form-label"></label>
                    <input asp-for="ContactNumber" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                </div>

                <h6 class="text-muted mt-2 mb-0">Address</h6>

                <div class="col-md-4">
                    <label asp-for="CityId" class="form-label"></label>
                    <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities">
                        <option value="">-- Select city --</option>
                    </select>
                    <span asp-validation-for="CityId" class="field-validation-error"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="AddressLine1" class="form-label"></label>
                    <input asp-for="AddressLine1" class="form-control" autocomplete="address-line1" />
                    <span asp-validation-for="AddressLine1" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AddressLine2" class="form-label"></label>
                    <input asp-for="AddressLine2" class="form-control" autocomplete="address-line2" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PostalCode" class="form-label"></label>
                    <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
                    <span asp-validation-for="PostalCode" class="field-validation-error"></span>
                </div>

                <h6 class="text-muted mt-2 mb-0">Security</h6>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                    <span class="text-muted small">Minimum 8 characters with uppercase, lowercase and a digit.</span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Create Account</button>
                </div>
            </form>

            <hr class="my-4" />
            <div class="text-center">
                <span class="small text-muted">Already have an account?</span>
                <a class="small" asp-area="Identity" asp-controller="Account" asp-action="Login">Login</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
