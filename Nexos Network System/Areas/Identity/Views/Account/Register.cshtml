@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="section nx-register">
    <div class="container">
        <div class="nx-auth nx-auth--page nx-auth--wide-panel">
            <aside class="nx-auth__brand">
                <span class="nx-auth__glow" aria-hidden="true"></span>
                <span class="nx-auth__ring" aria-hidden="true"></span>

                <p class="nx-auth__tagline">New customer</p>
                <h1 class="nx-auth__headline">
                    Create your<br />
                    <span>NEXUS account.</span>
                </h1>

                <ul class="nx-auth__points">
                    <li>
                        <span class="nx-auth__point-icon"><svg class="svg-icon"><use href="#i-user" /></svg></span>
                        <div>
                            <strong>1. Your details</strong>
                            <span>Name, email and a contact number</span>
                        </div>
                    </li>
                    <li>
                        <span class="nx-auth__point-icon"><svg class="svg-icon"><use href="#i-map-pin" /></svg></span>
                        <div>
                            <strong>2. Service address</strong>
                            <span>Where we should install the connection</span>
                        </div>
                    </li>
                    <li>
                        <span class="nx-auth__point-icon"><svg class="svg-icon"><use href="#i-shield-check" /></svg></span>
                        <div>
                            <strong>3. Secure password</strong>
                            <span>Protects your bills, orders and profile</span>
                        </div>
                    </li>
                </ul>

                <p class="nx-auth__foot">
                    Already registered? <a asp-area="Identity" asp-controller="Account" asp-action="Login">Sign in</a>
                </p>
            </aside>

            <div class="nx-auth__panel">
                <header class="nx-auth__panel-head">
                    <h2>Create your account</h2>
                    <p>Register as a NEXUS customer. You will be able to log in right away.</p>
                </header>

                <form asp-area="Identity" asp-controller="Account" asp-action="Register" method="post" class="row g-3" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="col-12">
                        <div class="nx-form-section nx-form-section--tight">
                            <div class="nx-form-section__head">
                                <span class="nx-form-section__step">1</span>
                                <h3>Personal details</h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-user" /></svg>
                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        </div>
                        <span asp-validation-for="FirstName" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-user" /></svg>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        </div>
                        <span asp-validation-for="LastName" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-envelope" /></svg>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactNumber" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-phone" /></svg>
                            <input asp-for="ContactNumber" class="form-control" autocomplete="tel" />
                        </div>
                        <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                    </div>

                    <div class="col-12">
                        <div class="nx-form-section">
                            <div class="nx-form-section__head">
                                <span class="nx-form-section__step">2</span>
                                <h3>Service address</h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="CityId" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-map-pin" /></svg>
                            <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities">
                                <option value="">-- Select city --</option>
                            </select>
                        </div>
                        <span asp-validation-for="CityId" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="AddressLine1" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-map-pin" /></svg>
                            <input asp-for="AddressLine1" class="form-control" autocomplete="address-line1" />
                        </div>
                        <span asp-validation-for="AddressLine1" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AddressLine2" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-map-pin" /></svg>
                            <input asp-for="AddressLine2" class="form-control" autocomplete="address-line2" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PostalCode" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-map-pin" /></svg>
                            <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
                        </div>
                        <span asp-validation-for="PostalCode" class="field-validation-error"></span>
                    </div>

                    <div class="col-12">
                        <div class="nx-form-section">
                            <div class="nx-form-section__head">
                                <span class="nx-form-section__step">3</span>
                                <h3>Security</h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-shield-check" /></svg>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                        <p class="form-text small mb-0">Minimum 8 characters with uppercase, lowercase and a digit.</p>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-shield-check" /></svg>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-lg w-100 nx-auth__submit">
                            Create Account
                            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                        </button>
                    </div>
                </form>

                <div class="nx-auth__alt">
                    <span>Already have an account?</span>
                    <a asp-area="Identity" asp-controller="Account" asp-action="Login">Login</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
