@model LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Login";
    Layout = null;
    var isDevelopment = Environment.IsDevelopment();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - NEXUS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // NEXUS boot loader gate: decide before first paint whether the
        // intro animation may play (first page of a session, motion allowed).
        (function () {
            try {
                if (sessionStorage.getItem("nx-boot-skip") ||
                    window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    document.documentElement.classList.add("nx-boot-skip");
                }
            } catch (e) {
                document.documentElement.classList.add("nx-boot-skip");
            }
        })();
    </script>
</head>
<body>
    <div id="nx-loader" aria-hidden="true">
        <div class="nx-loader-inner">
            <span class="nx-logo-ghost"></span>
            <span class="nx-logo-fill"></span>
            <span class="nx-logo-glow"></span>
            <span class="nx-loader-word">NEXUS</span>
            <span class="nx-loader-bar"></span>
        </div>
    </div>
    <partial name="_Icons" />
    <div class="login-page">
        <div class="nx-auth">
            <aside class="nx-auth__brand">
                <span class="nx-auth__glow" aria-hidden="true"></span>
                <span class="nx-auth__ring" aria-hidden="true"></span>

                <a class="nx-auth__logo brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <partial name="_Brand" />
                </a>
                <p class="nx-auth__tagline">Network &amp; Internet Services</p>
                <h1 class="nx-auth__headline">
                    One account.<br />
                    <span>Every NEXUS service.</span>
                </h1>

                <ul class="nx-auth__points">
                    <li>
                        <span class="nx-auth__point-icon"><svg class="svg-icon"><use href="#i-signal" /></svg></span>
                        <div>
                            <strong>Live connection status</strong>
                            <span>Speed, uptime and your current plan</span>
                        </div>
                    </li>
                    <li>
                        <span class="nx-auth__point-icon"><svg class="svg-icon"><use href="#i-credit-card" /></svg></span>
                        <div>
                            <strong>Bills &amp; payments</strong>
                            <span>Invoices, dues and payment history</span>
                        </div>
                    </li>
                    <li>
                        <span class="nx-auth__point-icon"><svg class="svg-icon"><use href="#i-headset" /></svg></span>
                        <div>
                            <strong>Support &amp; orders</strong>
                            <span>Track requests and talk to our team</span>
                        </div>
                    </li>
                </ul>

                <p class="nx-auth__foot">
                    Need a hand? <a asp-area="" asp-controller="Home" asp-action="Contact">Contact support</a>
                </p>
            </aside>

            <div class="nx-auth__panel">
                <header class="nx-auth__panel-head">
                    <h2>Welcome back</h2>
                    <p>Sign in to open your NEXUS panel.</p>
                </header>

                <form asp-area="Identity" asp-controller="Account" asp-action="Login" method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-envelope" /></svg>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="you@nexos.local" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-with-icon">
                            <svg class="svg-icon input-icon input-icon--left" aria-hidden="true"><use href="#i-shield-check" /></svg>
                            <input asp-for="Password" class="form-control form-control-lg" placeholder="Your password" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="nx-auth__row">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small"></label>
                        </div>
                        <a class="small" asp-area="Identity" asp-controller="Account" asp-action="AccessDenied">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 nx-auth__submit">
                        Sign in
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                    </button>
                </form>

                @if (isDevelopment)
                {
                    <div class="alert alert-info small mt-4 mb-0">
                        <strong>Demo accounts</strong> (development only, password <code>Nexos@@123</code>):<br />
                        admin@@nexos.local &middot; retail@@nexos.local &middot; technical@@nexos.local &middot; accounts@@nexos.local &middot; customer@@nexos.local
                    </div>
                }

                <div class="nx-auth__alt">
                    <span>New to NEXUS?</span>
                    <a asp-area="Identity" asp-controller="Account" asp-action="Register">Create an account</a>
                </div>

                <a class="nx-auth__back" asp-area="" asp-controller="Home" asp-action="Index">&larr; Back to public website</a>

                <p class="nx-auth__note">
                    Password reset requires email delivery, which is not configured in this phase.
                    Please contact an administrator to reset your password.
                </p>
            </div>
        </div>
    </div>
</body>
</html>
