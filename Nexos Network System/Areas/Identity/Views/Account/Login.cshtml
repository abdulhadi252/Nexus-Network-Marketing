@model LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Login";
    Layout = null;
    var isDevelopment = Environment.IsDevelopment();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - NEXUS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // NEXUS boot loader gate: decide before first paint whether the
        // intro animation may play (first page of a session, motion allowed).
        (function () {
            try {
                if (sessionStorage.getItem("nx-boot-skip") ||
                    window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    document.documentElement.classList.add("nx-boot-skip");
                }
            } catch (e) {
                document.documentElement.classList.add("nx-boot-skip");
            }
        })();
    </script>
</head>
<body>
    <div id="nx-loader" aria-hidden="true">
        <div class="nx-loader-inner">
            <span class="nx-logo-ghost"></span>
            <span class="nx-logo-fill"></span>
            <span class="nx-logo-glow"></span>
            <span class="nx-loader-word">NEXUS</span>
            <span class="nx-loader-bar"></span>
        </div>
    </div>
    <div class="login-page">
        <div class="login-card">
            <div class="card p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold mb-1 login-brand"><partial name="_Brand" /></h3>
                    <p class="text-muted small mb-0">Sign in to your panel</p>
                </div>

                <form asp-area="Identity" asp-controller="Account" asp-action="Login" method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="you@nexos.local" autocomplete="username" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="Your password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small"></label>
                        </div>
                        <a class="small" asp-area="Identity" asp-controller="Account" asp-action="AccessDenied">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Login</button>
                </form>

                @if (isDevelopment)
                {
                    <div class="alert alert-info small mt-4 mb-0">
                        <strong>Demo accounts</strong> (development only, password <code>Nexos@@123</code>):<br />
                        admin@@nexos.local &middot; retail@@nexos.local &middot; technical@@nexos.local &middot; accounts@@nexos.local &middot; customer@@nexos.local
                    </div>
                }

                <hr class="my-4" />
                <div class="text-center">
                    <a class="small" asp-area="" asp-controller="Home" asp-action="Index">&larr; Back to public website</a>
                </div>
            </div>
            <p class="text-center text-white-50 small mt-3 mb-0">
                Password reset requires email delivery, which is not configured in this phase.
                Please contact an administrator to reset your password.
            </p>
        </div>
    </div>
</body>
</html>
