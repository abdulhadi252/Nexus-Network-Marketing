@model DashboardStatsViewModel
@{
    ViewData["Title"] = "Retail Dashboard";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Retail Dashboard</h1>
        <p class="text-muted mb-0">Register customers and place service orders for your branch.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="Customers" asp-action="Create">+ New Customer</a>
        <a class="btn btn-primary" asp-controller="Orders" asp-action="Create">+ New Order</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-customers" /></svg></span>
            <div class="stat-label">Customers</div>
            <div class="stat-value">@Model.TotalCustomers</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-orders" /></svg></span>
            <div class="stat-label">Orders</div>
            <div class="stat-value">@Model.TotalOrders</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-clock" /></svg></span>
            <div class="stat-label">Pending Orders</div>
            <div class="stat-value">@Model.PendingOrders</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-connections" /></svg></span>
            <div class="stat-label">Active Connections</div>
            <div class="stat-value">@Model.ActiveConnections</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-bills" /></svg></span>
            <div class="stat-label">Bills With Dues</div>
            <div class="stat-value">@Model.OutstandingBills</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-wallet" /></svg></span>
            <div class="stat-label">Payments Received</div>
            <div class="stat-value">PKR @Model.PaymentsReceived.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card card">
            <span class="stat-icon"><svg class="svg-icon"><use href="#i-plans" /></svg></span>
            <div class="stat-label">Active Plans</div>
            <div class="stat-value">@Model.TotalPlans</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Recent Orders</span>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Orders" asp-action="Index">View all</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentOrders.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><svg class="svg-icon"><use href="#i-orders" /></svg></div>
                <p class="mb-2">No orders have been placed yet.</p>
                <a class="btn btn-sm btn-primary" asp-controller="Orders" asp-action="Create">Create the first order</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Order</th><th>Customer</th><th>Type</th><th>Plan</th><th>Submitted</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td class="fw-semibold">@order.OrderNumber</td>
                                <td>@order.Customer.FirstName @order.Customer.LastName</td>
                                <td>@order.ConnectionType</td>
                                <td>@(order.Plan?.Name ?? "-")</td>
                                <td>@order.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td><partial name="_Badge" model="@((object?)order.Status)" /></td>
                                <td class="table-actions">
                                    <a class="btn btn-outline-secondary" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
