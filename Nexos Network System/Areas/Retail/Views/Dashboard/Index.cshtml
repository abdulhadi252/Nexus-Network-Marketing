@model DashboardStatsViewModel
@{
    ViewData["Title"] = "Retail Dashboard";

    var recentOrders = Model.RecentOrders;
}

<div class="dash-head">
    <div>
        <h1>Retail Dashboard</h1>
        <p>Welcome back, @Model.GreetingName! Register customers and place service orders for your branch.</p>
    </div>
    <div class="dash-period" title="Reporting period">
        <svg class="svg-icon"><use href="#i-calendar" /></svg>
        <span>@Model.PeriodLabel</span>
    </div>
</div>

@* ---------------------------------------------------------------- KPI cards *@
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--blue"><svg class="svg-icon"><use href="#i-customers" /></svg></span>
                <span class="kpi-card__label">Customers</span>
            </div>
            <div class="kpi-card__value">@Model.TotalCustomers.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--green"><svg class="svg-icon"><use href="#i-orders" /></svg></span>
                <span class="kpi-card__label">Orders</span>
            </div>
            <div class="kpi-card__value">@Model.TotalOrders.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--orange"><svg class="svg-icon"><use href="#i-clock" /></svg></span>
                <span class="kpi-card__label">Pending Orders</span>
            </div>
            <div class="kpi-card__value">@Model.PendingOrders.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--navy"><svg class="svg-icon"><use href="#i-connections" /></svg></span>
                <span class="kpi-card__label">Active Connections</span>
            </div>
            <div class="kpi-card__value">@Model.ActiveConnections.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--purple"><svg class="svg-icon"><use href="#i-bills" /></svg></span>
                <span class="kpi-card__label">Bills With Dues</span>
            </div>
            <div class="kpi-card__value">@Model.OutstandingBills.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--cyan"><svg class="svg-icon"><use href="#i-wallet" /></svg></span>
                <span class="kpi-card__label">Payments Received</span>
            </div>
            <div class="kpi-card__value">PKR @Model.PaymentsReceived.ToString("N0")</div>
        </article>
    </div>
    <div class="col-6 col-xl-3">
        <article class="kpi-card">
            <div class="kpi-card__top">
                <span class="kpi-card__icon kpi-card__icon--blue"><svg class="svg-icon"><use href="#i-plans" /></svg></span>
                <span class="kpi-card__label">Active Plans</span>
            </div>
            <div class="kpi-card__value">@Model.TotalPlans.ToString("N0")</div>
        </article>
    </div>
</div>

@* ---------------------------------------------------------------- Recent orders *@
<section class="dash-card">
    <header class="dash-card__head">
        <span class="dash-card__icon"><svg class="svg-icon"><use href="#i-orders" /></svg></span>
        <div class="dash-card__heading">
            <h2 class="dash-card__title">Recent Orders</h2>
            <p class="dash-card__sub">
                @if (recentOrders.Count == 0)
                {
                    <text>No orders placed yet</text>
                }
                else
                {
                    <text>Latest @recentOrders.Count.ToString("N0") order@(recentOrders.Count == 1 ? string.Empty : "s") at your branch</text>
                }
            </p>
        </div>
        <a class="btn btn-sm btn-outline-primary order-card__cta ms-auto"
           asp-controller="Orders" asp-action="Index">
            View All
        </a>
    </header>
    <div class="dash-card__body dash-card__body--flush">
        @if (recentOrders.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon"><svg class="svg-icon" aria-hidden="true"><use href="#i-orders" /></svg></span>
                <p class="empty-title">No orders have been placed yet.</p>
                <p class="mb-3">Orders you register at this branch will appear here.</p>
                <a class="btn btn-sm btn-primary" asp-controller="Orders" asp-action="Create">Create the first order</a>
            </div>
        }
        else
        {
            <ul class="order-list">
                @foreach (var order in recentOrders)
                {
                    <partial name="_OrderRow" model="order" />
                }
            </ul>
        }
    </div>
</section>
