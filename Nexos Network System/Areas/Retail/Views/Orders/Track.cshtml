@model Order?
@{
    ViewData["Title"] = "Track Order";
    var searchTerm = ViewData["SearchTerm"] as string;
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Retail" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Track Order</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Track Order</h1>
        <p class="page-subtitle">Enter a full order number to check its current status.</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="orderNumber">Order Number</label>
                <input type="text" id="orderNumber" name="orderNumber" value="@searchTerm" class="form-control" placeholder="B0000000001" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Track</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(searchTerm))
{
    if (Model is null)
    {
        <div class="card">
            <div class="empty-state">
                <div class="empty-icon">&#128269;</div>
                <p class="mb-0">No order found with number <strong>@searchTerm</strong>.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h5 class="mb-1">@Model.OrderNumber</h5>
                    <p class="text-muted small mb-0">
                        @Model.Customer.FirstName @Model.Customer.LastName &middot;
                        @Model.ConnectionType &middot; submitted @Model.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </p>
                </div>
                <partial name="_StatusPill" model="@((object?)Model.Status)" />
            </div>
            <hr />
            <dl class="row detail-list mb-3">
                <dt class="col-sm-4">Plan</dt>
                <dd class="col-sm-8">@(Model.Plan?.Name ?? "Not assigned")</dd>
                <dt class="col-sm-4">Connection</dt>
                <dd class="col-sm-8">
                    @if (Model.Connection is null)
                    {
                        @("Not created yet")
                    }
                    else
                    {
                        <a asp-controller="Connections" asp-action="Details" asp-route-id="@Model.Connection.Id">@Model.Connection.AccountNumber</a>
                    }
                </dd>
                <dt class="col-sm-4">Last updated</dt>
                <dd class="col-sm-8">@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
            </dl>
            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@Model.Id">Open full order details</a>
        </div>
    }
}
