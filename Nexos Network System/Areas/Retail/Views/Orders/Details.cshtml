@model Order
@{
    ViewData["Title"] = "Order Details";
    var address = Model.Customer.Addresses.OrderByDescending(a => a.IsPrimary).FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Order @Model.OrderNumber</h1>
        <p class="text-muted mb-0">
            @Model.ConnectionType &middot; @Model.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm") &middot;
            <partial name="_Badge" model="@((object?)Model.Status)" />
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Create" asp-route-customerId="@Model.CustomerId">+ New Order</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to orders</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card p-4 mb-3">
            <h6 class="mb-3">Customer</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-5">Name</dt>
                <dd class="col-7">@Model.Customer.FirstName @Model.Customer.LastName</dd>
                <dt class="col-5">Contact</dt>
                <dd class="col-7">@Model.Customer.PrimaryContactNumber</dd>
                <dt class="col-5">Email</dt>
                <dd class="col-7">@Model.Customer.Email</dd>
                <dt class="col-5">Address</dt>
                <dd class="col-7">@(address is null ? "-" : $"{address.AddressLine1}, {address.City?.Name}")</dd>
            </dl>
        </div>

        <div class="card p-4">
            <h6 class="mb-3">Order Items</h6>
            @if (Model.Items.Count == 0)
            {
                <p class="text-muted mb-0">No products were added to this order.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Product</th><th>Qty</th><th class="text-end">Unit price</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Product.Name</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-end text-price">PKR @item.UnitPrice.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card p-4 mb-3">
            <h6 class="mb-3">Order Progress</h6>
            <dl class="row detail-list mb-0">
                <dt class="col-5">Plan</dt>
                <dd class="col-7">@(Model.Plan?.Name ?? "-")</dd>
                <dt class="col-5">Retail shop</dt>
                <dd class="col-7">@(Model.RetailShop?.Name ?? "-")</dd>
                <dt class="col-5">Processed by</dt>
                <dd class="col-7">@(Model.ProcessedByEmployee is null ? "-" : $"{Model.ProcessedByEmployee.FirstName} {Model.ProcessedByEmployee.LastName}")</dd>
                <dt class="col-5">Last updated</dt>
                <dd class="col-7">@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                <dt class="col-5">Feasibility</dt>
                <dd class="col-7">
                    @if (Model.FeasibilityReport is null)
                    {
                        @("Not checked yet")
                    }
                    else
                    {
                        <partial name="_Badge" model="@((object?)Model.FeasibilityReport.Status)" />
                    }
                </dd>
                <dt class="col-5">Connection</dt>
                <dd class="col-7">
                    @if (Model.Connection is null)
                    {
                        @("Not created yet")
                    }
                    else
                    {
                        <a asp-controller="Connections" asp-action="Details" asp-route-id="@Model.Connection.Id">@Model.Connection.AccountNumber</a>
                    }
                </dd>
                <dt class="col-5">Remarks</dt>
                <dd class="col-7">@(Model.Remarks ?? "-")</dd>
            </dl>
        </div>

        <div class="card p-4">
            <h6 class="mb-3">What happens next?</h6>
            <ul class="text-muted small mb-0">
                <li>Technical staff perform a feasibility check at the customer address.</li>
                <li>Once feasible, the connection is created and an account number is issued.</li>
                <li>Installation and activation are recorded by the technical team.</li>
                <li>Accounts staff generate the monthly bill with 12.24% service tax.</li>
            </ul>
        </div>
    </div>
</div>
