@model PagedResult<Plan>
@{
    ViewData["Title"] = "Plans";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-area="Retail" asp-controller="Dashboard" asp-action="Index">
        <svg class="svg-icon" aria-hidden="true"><use href="#i-home-clean" /></svg>
        <span>Dashboard</span>
    </a>
    <span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
    <span class="crumbs__current" aria-current="page">Available Plans</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h3">Available Plans</h1>
        <p class="page-subtitle">Active plans that can be offered to customers. Pricing is managed by the administrator.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input type="text" name="q" value="@ViewData["q"]" class="form-control" placeholder="Search plan name..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><p class="mb-0">No active plans available.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Plan</th><th>Type</th><th>Cycle</th><th>Charge</th><th>Deposit</th><th>Installation</th><th>Speed / Hours</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @plan.Name
                                    <div class="text-muted small">@plan.Description</div>
                                </td>
                                <td>@plan.ConnectionType</td>
                                <td>@plan.BillingCycle</td>
                                <td class="text-price">PKR @plan.RecurringCharge.ToString("N2")</td>
                                <td class="text-price">PKR @plan.SecurityDeposit.ToString("N2")</td>
                                <td class="text-price">PKR @plan.InstallationCharge.ToString("N2")</td>
                                <td>
                                    @if (plan.SpeedMbps.HasValue)
                                    {
                                        @($"{plan.SpeedMbps} Mbps")
                                    }
                                    else if (plan.IncludedUsageHours.HasValue)
                                    {
                                        @($"{plan.IncludedUsageHours} hrs")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        }
    </div>
</div>
